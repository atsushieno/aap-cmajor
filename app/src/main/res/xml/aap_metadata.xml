<plugins xmlns="urn:org.androidaudioplugin.core"
    xmlns:gui="urn://androidaudioplugin.org/extensions/gui">
  <!-- Both plugins share the library and the UI, see PluginDescriptor in cmaj_AAPPlugin.cpp.
       Their audio buses follow the loaded patch (buses extension, declared by bom 0.12.1). -->
  <plugin name="AAP Cmajor Instrument" category="Instrument" developer="AAP Developers"
      unique-id="urn:org.androidaudioplugin/samples/cmajor/AAPCMajorSample"
      library="libaap-cmajor-sample.so"
      gui:ui-view-factory="org.androidaudioplugin.ports.cmajor.CmajorPatchViewFactory">
    <extensions bom="0.12.1" />
  </plugin>
  <plugin name="AAP Cmajor Effect" category="Effect" developer="AAP Developers"
      unique-id="urn:org.androidaudioplugin/samples/cmajor/AAPCmajorEffect"
      library="libaap-cmajor-sample.so"
      gui:ui-view-factory="org.androidaudioplugin.ports.cmajor.CmajorPatchViewFactory">
    <extensions bom="0.12.1" />
  </plugin>
</plugins>
