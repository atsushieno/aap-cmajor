+cmake_minimum_required(VERSION 3.16..3.22)
+
+# Experimental Android Audio Plugin (AAP) backend for cmajor - see cmaj_AAPPlugin.cpp.
+# This only makes sense (and only gets configured) when building for Android, since it
+# depends on the androidaudioplugin prefab package.
+
+find_package (androidaudioplugin REQUIRED CONFIG)
+
+MAKE_CMAJ_LIBRARY (
+    LIBRARY_NAME aap_cmajor_engine_lib
+    INCLUDE_PLAYBACK
+    ENABLE_PERFORMER_LLVM
+)
+
+add_library(aap-cmajor-sample SHARED
+    cmaj_AAPPlugin.cpp
+)
+
+target_compile_features(aap-cmajor-sample PRIVATE cxx_std_17)
+
+# Patch workers run in QuickJS, since there's no WebView to host them in a plugin service.
+target_compile_definitions(aap-cmajor-sample PRIVATE CMAJ_USE_QUICKJS_WORKER=1)
+
+target_link_libraries(aap-cmajor-sample
+    PRIVATE
+        aap_cmajor_engine_lib
+        cmaj_clap
+        androidaudioplugin::androidaudioplugin
+        android
+        log
+        ${CMAKE_DL_LIBS}
+)
