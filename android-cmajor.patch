+++ b/modules/plugin/include/aap/cmaj_AAPPlugin.cpp
@@ -0,0 +1,382 @@
+//
+//     ,ad888ba,                              88
+//    d8"'    "8b
+//   d8            88,dba,,adba,   ,aPP8A.A8  88     The Cmajor Toolkit
+//   Y8,           88    88    88  88     88  88
