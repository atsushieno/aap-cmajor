+extern "C" AndroidAudioPluginFactory* GetAndroidAudioPluginFactory()
+{
+    return &cmaj::plugin::aap::factory;
+}
+
+// Blocks while the patch is built. Returns an error message, or null on success.
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_androidaudioplugin_ports_cmajor_CmajorNative_loadPatch (JNIEnv* env, jclass, jlong serviceInstance, jint instanceId, jstring identity)
+{
+    using namespace cmaj::plugin::aap;
+
+    auto wrapper = findWrapper (serviceInstance, instanceId);
+
+    if (wrapper == nullptr)
+        return toJavaString (env, "The plugin instance is gone");
+
+    auto error = wrapper->loadPatch (toString (env, identity), std::nullopt, true);
+    return error.empty() ? nullptr : toJavaString (env, error);
+}
+
+// Returns the instance's patch status as JSON (see Wrapper::getStatus()), or null if the instance is gone.
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_androidaudioplugin_ports_cmajor_CmajorNative_getPatchStatus (JNIEnv* env, jclass, jlong serviceInstance, jint instanceId)
+{
+    auto wrapper = cmaj::plugin::aap::findWrapper (serviceInstance, instanceId);
+    return wrapper != nullptr ? cmaj::plugin::aap::toJavaString (env, wrapper->getStatus()) : nullptr;
+}
+
+// The size of the current patch's own view in CSS pixels, or null if it has none.
+extern "C" JNIEXPORT jintArray JNICALL
+Java_org_androidaudioplugin_ports_cmajor_CmajorNative_getPatchViewSize (JNIEnv* env, jclass, jlong serviceInstance, jint instanceId)
+{
+    auto wrapper = cmaj::plugin::aap::findWrapper (serviceInstance, instanceId);
