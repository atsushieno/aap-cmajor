@@ -439,6 +441,25 @@ function (MAKE_CMAJ_LIBRARY)
             ${CHOC_TARGET}
     )
 
+    if (${CMAKE_SYSTEM_NAME} MATCHES "Android")
+        # The Android NDK's linker (lld) uses --gc-sections by default, which strips the
+        # object files inside LLVM's target-description static libraries that only exist to
+        # run self-registering static initializers (they register each CPU/feature with
+        # LLVM's TargetRegistry, but are never directly referenced by symbol name from
+        # anywhere else). Without those, LLVM's TargetMachine can't recognise the host CPU
+        # or any of its features at runtime ("'cortex-a78' is not a recognized processor for
+        # this target"), and falls back to a subtarget that doesn't support 64-bit codegen at
+        # all ("LLVM ERROR: 64-bit code requested on a subtarget that doesn't support it!").
+        # Forcing --whole-archive for just the platform codegen libs (LLVM*Info/Desc/etc.)
+        # keeps those initializers in the final binary.
+        target_link_libraries (${CMAJ_LIBRARY_NAME}
+            PRIVATE
+                "-Wl,--whole-archive"
+                ${LLVM_PLATFORM_LIBS}
+                "-Wl,--no-whole-archive"
+        )
+    endif()
+
     if (CMAJ_INCLUDE_SCRIPTING)
         if (${CMAKE_SYSTEM_NAME} MATCHES "Linux")
             find_package(PkgConfig REQUIRED)
