+++ b/modules/plugin/include/aap/cmaj_AAPPlugin.cpp
@@ -0,0 +1,1639 @@
+//
+//     ,ad888ba,                              88
+//    d8"'    "8b
+//   d8            88,dba,,adba,   ,aPP8A.A8  88     The Cmajor Toolkit
+//   Y8,           88    88    88  88     88  88
+//    Y8a.   .a8P  88    88    88  88,   ,88  88     (C)2024 Cmajor Software Ltd
+//     '"Y888Y"'   88    88    88  '"8bbP"Y8  88     https://cmajor.dev
+//                                           ,88
+//                                        888P"
+//
+//  The Cmajor project is subject to commercial or open-source licensing.
+//  You may use it under the terms of the GPLv3 (see www.gnu.org/licenses), or
+//  visit https://cmajor.dev to learn about our commercial licence options.
+//
+//  CMAJOR IS PROVIDED "AS IS" WITHOUT ANY WARRANTY, AND ALL WARRANTIES, WHETHER
+//  EXPRESSED OR IMPLIED, INCLUDING MERCHANTABILITY AND FITNESS FOR PURPOSE, ARE
+//  DISCLAIMED.
+
+// This is an experimental Android Audio Plugin (AAP) backend for cmajor.
+//
+// Rather than a new cmajor performer backend, it's a thin adapter that hosts the
+// existing cmaj::plugin::clap::create() CLAP plugin (see ../clap/cmaj_CLAPPlugin.h)
+// inside AAP's C plugin ABI (see aap/android-audio-plugin.h). CLAP and AAP are both
+// plain C, struct-of-function-pointers plugin ABIs, so the two map onto each other
+// fairly directly - prepare/activate/process/deactivate on the AAP side become
+// activate/start_processing/process/stop_processing on the CLAP side.
+//
+// It provides two plugins, an instrument and an effect (see PluginDescriptor). Each plugin
+// instance runs one patch from the APK assets at a time (Pro54 or Tremolo by default), built
+// by cmajor's JIT engine at runtime (no ahead-of-time codegen needed), and can switch to
+// another one (see Wrapper::loadPatch()). It handles audio ports, parameters (exposed
+// through AAP's parameters extension, with parameter changes arriving as AAP parameter
+// SysEx8 on the MIDI2 input port), MIDI channel messages and state (the patch, plus
+// cmajor's own state of it), and embeds the patch's own view as the AAP native UI (see
+// CmajorPatchViewFactory.kt).
+
+#include "../clap/cmaj_CLAPPlugin.h"
+
+#include <aap/android-audio-plugin.h>
+#include <aap/core/android/android-application-context.h>
+#include "choc/platform/choc_AndroidJNIHelpers.h"
+#include <aap/ext/parameters.h>
+#include <aap/ext/midi.h>
+#include <aap/ext/state.h>
+#include <aap/ext/buses.h>
+#include <aap/ext/plugin-info.h>
+#include <aap/core/host/plugin-host.h>
+#include <android/asset_manager_jni.h>
+
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <numeric>
+#include <optional>
+#include <string_view>
+#include <unordered_map>
+#include <vector>
+
+namespace cmaj::plugin::aap
+{
+
+//==============================================================================
+// A patch is identified by a URI. So far all of them are bundled in the APK assets (the app
+// bundles cmajor's examples/patches as assets/patches), e.g.
+// "cmajor-asset:///patches/Pro54/Pro54.cmajorpatch".
+static constexpr std::string_view assetPatchScheme = "cmajor-asset:///";
+
+//==============================================================================
+// The app has two AAP plugins sharing all of this code: an instrument, and an effect. Their
+// audio buses follow the loaded patch's audio ports (see AudioRouting and the buses extension).
+struct PluginDescriptor
+{
+    const char* pluginID;
+    const char* localName;
+    const char* displayName;
+    const char* category;
+    const char* defaultPatchIdentity;
+    bool hasAudioInput; // in the default bus layout, before a patch is built
+};
+
+static const PluginDescriptor instrumentPlugin
+{
+    "urn:org.androidaudioplugin/samples/cmajor/AAPCMajorSample",
+    "AAPCMajorSample",
+    "AAP Cmajor Instrument",
+    "Instrument",
+    "cmajor-asset:///patches/Pro54/Pro54.cmajorpatch",
+    false
+};
+
+static const PluginDescriptor effectPlugin
+{
+    "urn:org.androidaudioplugin/samples/cmajor/AAPCmajorEffect",
+    "AAPCmajorEffect",
+    "AAP Cmajor Effect",
+    "Effect",
+    "cmajor-asset:///patches/Tremolo/Tremolo.cmajorpatch",
+    true
+};
+
+// An AAP audio bus, i.e. one of the patch's audio ports.
+struct AudioBusInfo
+{
+    uint32_t id;
+    std::string name;
+    uint32_t channelCount;
+    std::string layout;
+
+    bool operator== (const AudioBusInfo& other) const
+    {
+        return id == other.id && name == other.name && channelCount == other.channelCount && layout == other.layout;
+    }
+};
+
+// The default bus layout of each plugin (stereo), for when no patch is built yet.
+inline std::array<std::vector<AudioBusInfo>, 2> getDefaultBuses (const PluginDescriptor& descriptor)
+{
+    std::array<std::vector<AudioBusInfo>, 2> buses;
+
+    if (descriptor.hasAudioInput)
+        buses[0].push_back ({ 0, "Audio In", 2, "stereo" });
+
+    buses[1].push_back ({ 0x100, "Audio Out", 2, "stereo" });
+    return buses;
+}
+
+inline const PluginDescriptor* findPluginDescriptor (std::string_view pluginID)
+{
+    for (auto descriptor : { std::addressof (instrumentPlugin), std::addressof (effectPlugin) })
+        if (pluginID == descriptor->pluginID)
+            return descriptor;
+
+    return nullptr;
+}
+
+struct PatchLocation
+{
+    std::filesystem::path assetFolder;
+    std::filesystem::path manifestFile;
+};
+
+// The path relative to its root, as long as it doesn't escape from there.
+inline std::optional<std::filesystem::path> toContainedRelativePath (const std::filesystem::path& path)
+{
+    auto result = path.relative_path().lexically_normal();
+
+    if (result.empty() || *result.begin() == "..")
+        return {};
+
+    return result;
+}
+
+inline std::optional<PatchLocation> resolvePatchIdentity (std::string_view identity)
+{
+    if (identity.substr (0, assetPatchScheme.size()) != assetPatchScheme)
+        return {};
+
+    auto path = toContainedRelativePath (std::string (identity.substr (assetPatchScheme.size())));
+
+    if (! path || path->extension() != ".cmajorpatch")
+        return {};
+
+    return PatchLocation { path->parent_path(), path->filename() };
+}
+
+// The Java AssetManager must outlive the native one obtained from it, so its global
+// reference is deliberately never released.
+inline AAssetManager* getAssetManager()
+{
+    static AAssetManager* assetManager = []() -> AAssetManager*
+    {
+        auto env = choc::android::getEnv();
+        auto context = choc::android::getApplicationContext();
+
+        if (env == nullptr || context == nullptr)
+            return nullptr;
+
+        auto contextClass = env->GetObjectClass (context);
+        auto getAssets = env->GetMethodID (contextClass, "getAssets", "()Landroid/content/res/AssetManager;");
+        auto assets = getAssets != nullptr ? env->CallObjectMethod (context, getAssets) : nullptr;
+        env->DeleteLocalRef (contextClass);
+
+        if (choc::android::checkAndClearException (*env) || assets == nullptr)
+            return nullptr;
+
+        auto globalAssets = env->NewGlobalRef (assets);
+        env->DeleteLocalRef (assets);
+        return AAssetManager_fromJava (env, globalAssets);
+    }();
+
+    return assetManager;
+}
+
+inline AAsset* openPatchAsset (const PatchLocation& location, const std::filesystem::path& path, int mode)
+{
+    auto assetManager = getAssetManager();
+    auto relativePath = toContainedRelativePath (path);
+
+    if (assetManager == nullptr || ! relativePath)
+        return nullptr;
+
+    auto assetPath = (location.assetFolder / *relativePath).generic_string();
+    return AAssetManager_open (assetManager, assetPath.c_str(), mode);
+}
+
+using StatusCallback = std::function<void(const cmaj::Patch::Status&)>;
+
+inline cmaj::plugin::Environment createEnvironment (const PatchLocation& location, StatusCallback statusChanged = {})
+{
+    auto readFile = [location] (const std::filesystem::path& path) -> std::unique_ptr<std::istream>
+    {
+        auto asset = openPatchAsset (location, path, AASSET_MODE_BUFFER);
+
+        if (asset == nullptr)
+            return {};
+
+        std::unique_ptr<std::istream> result;
+
+        if (auto data = static_cast<const char*> (AAsset_getBuffer (asset)))
+            result = std::make_unique<std::istringstream> (std::string (data, static_cast<size_t> (AAsset_getLength (asset))), std::ios::binary);
+
+        AAsset_close (asset);
+        return result;
+    };
+
+    auto fileExists = [location] (const std::filesystem::path& path)
+    {
+        auto asset = openPatchAsset (location, path, AASSET_MODE_UNKNOWN);
+
+        if (asset == nullptr)
+            return false;
+
+        AAsset_close (asset);
+        return true;
+    };
+
+    // Asset files never change, so the fixed modification time keeps the JIT engine from
+    // ever rebuilding the patch by itself.
+    return
+    {
+        cmaj::plugin::Environment::EngineType::JIT,
+        [] { return cmaj::Engine::create(); },
+        cmaj::plugin::Environment::VirtualFileSystem
+        {
+            readFile,
+            [] (const std::filesystem::path& path) { return path; },
+            [] (const std::filesystem::path&) -> std::filesystem::file_time_type { return {}; },
+            fileExists
+        },
+        std::move (statusChanged)
+    };
+}
+
+//==============================================================================
+// What the manifest says about a patch, which is available without building it.
+struct PatchDescription
+{
+    std::string name;
+
+    // The size of the patch's own view in CSS pixels (zero where the view doesn't say), if it has one.
+    std::optional<std::array<uint32_t, 2>> viewSize;
+};
+
+inline std::optional<PatchDescription> describePatch (const PatchLocation& location)
+{
+    auto manifest = createEnvironment (location).makePatchManifest (location.manifestFile);
+
+    if (! manifest.manifest.isObject())
+        return {};
+
+    PatchDescription result;
+    result.name = manifest.name.empty() ? location.manifestFile.stem().string() : manifest.name;
+
+    if (auto view = manifest.findDefaultView(); view != nullptr && ! view->getSource().empty())
+        result.viewSize = std::array<uint32_t, 2> { view->getWidth(), view->getHeight() };
+
+    return result;
+}
+
+//==============================================================================
+// cmajor's CLAP plugin only publishes its audio ports (and so only wires up its channel
+// buffers in process()) when the host claims to support CLAP_AUDIO_PORTS_RESCAN_LIST -
+// in the JIT case it otherwise leaves the port list empty, and then reads the input
+// channels from null pointers. Our ports are fixed and a CLAP plugin never changes its
+// patch after loading (we replace the whole plugin instead), so we can just say yes and
+// treat any rescan request as a no-op.
+static const clap_host_audio_ports_t hostAudioPorts
+{
+    [] (const clap_host_t*, uint32_t) -> bool { return true; },
+    [] (const clap_host_t*, uint32_t) {}
+};
+
+//==============================================================================
+// A minimal CLAP host. Apart from the audio ports extension above, this wrapper doesn't
+// (yet) forward any of the host-side CLAP extensions through to the AAP host, so the
+// rest of these are all no-ops for now.
+struct Host  : public clap_host_t
+{
+    Host()
+    {
+        clap_version = CLAP_VERSION;
+        host_data = nullptr;
+        name = "AAP";
+        vendor = "cmajor";
+        url = "";
+        version = "0.1";
+
+        get_extension = [] (const clap_host_t*, const char* extensionID) -> const void*
+        {
+            if (std::strcmp (extensionID, CLAP_EXT_AUDIO_PORTS) == 0)
+                return std::addressof (hostAudioPorts);
+
+            return nullptr;
+        };
+
+        request_restart  = [] (const clap_host_t*) {};
+        request_process  = [] (const clap_host_t*) {};
+        request_callback = [] (const clap_host_t*) {};
+    }
+};
+
+// The CLAP plugins keep references to these, and may outlive their Wrapper (see retirePatch()).
+static const Host sharedHost;
+static const clap_plugin_descriptor_t sharedDescriptor {};
+
+//==============================================================================
+// A loaded patch's parameters, as reported by its CLAP plugin. The AAP parameter ID of each
+// parameter is its index in this list (cmajor's CLAP parameter IDs are not guaranteed to fit
+// into AAP's 0-16383 ID range).
+struct ParameterTable
+{
+    std::vector<clap_param_info_t> infos;
+    std::unordered_map<clap_id, uint16_t> indexByID;
+};
+
+union InputEvent
+{
+    clap_event_header_t header;
+    clap_event_param_value_t parameter;
+    clap_event_midi_t midi;
+};
+
+// The last build error that cmajor reported for a patch. cmajor may report it from any thread.
+struct BuildLog
+{
+    void update (const cmaj::Patch::Status& status)
+    {
+        if (! status.messageList.hasErrors())
+            return;
+
+        std::lock_guard<std::mutex> l (lock);
+        lastError = status.statusMessage;
+    }
+
+    std::string getLastError()
+    {
+        std::lock_guard<std::mutex> l (lock);
+        return lastError;
+    }
+
+private:
+    std::mutex lock;
+    std::string lastError;
+};
+
+//==============================================================================
+// Connects a patch's audio ports to the plugin's audio buses, port by port. The main buses are
+// adapted when their channel counts differ (e.g. until the host prepares for a new bus layout);
+// other channels without a bus buffer are fed with silence or discarded.
+struct AudioRouting
+{
+    void build (const clap_plugin& plugin, uint32_t maxFramesToUse)
+    {
+        maxFrames = maxFramesToUse;
+        silence.assign (maxFrames, 0.0f);
+        discarded.assign (maxFrames, 0.0f);
+        monoMix.assign (maxFrames, 0.0f);
+
+        auto audioPorts = static_cast<const clap_plugin_audio_ports_t*> (plugin.get_extension (std::addressof (plugin), CLAP_EXT_AUDIO_PORTS));
+
+        auto getPorts = [&] (bool isInput)
+        {
+            std::vector<AudioBusInfo> ports;
+            auto numPorts = audioPorts != nullptr ? audioPorts->count (std::addressof (plugin), isInput) : 0;
+
+            for (uint32_t i = 0; i < numPorts; ++i)
+            {
+                clap_audio_port_info_t info {};
+
+                if (! audioPorts->get (std::addressof (plugin), i, isInput, std::addressof (info)))
+                    info.channel_count = 0;
+
+                std::string_view type = info.port_type != nullptr ? info.port_type : "";
+                ports.push_back ({ (isInput ? 0u : 0x100u) + i, info.name, info.channel_count,
+                                   type == CLAP_PORT_MONO || type == CLAP_PORT_STEREO ? std::string (type) : std::string() });
+            }
+
+            return ports;
+        };
+
+        auto createBuffers = [] (const std::vector<AudioBusInfo>& ports, std::vector<float*>& channels,
+                                 std::vector<clap_audio_buffer_t>& buffers, float* defaultChannel)
+        {
+            channels.assign (std::accumulate (ports.begin(), ports.end(), size_t(),
+                                              [] (size_t n, const AudioBusInfo& port) { return n + port.channelCount; }),
+                             defaultChannel);
+            buffers.clear();
+            auto next = channels.data();
+
+            for (auto& port : ports)
+            {
+                buffers.push_back ({ next, nullptr, port.channelCount, 0, 0 });
+                next += port.channelCount;
+            }
+        };
+
+        buses[0] = getPorts (true);
+        buses[1] = getPorts (false);
+        createBuffers (buses[0], inputChannels, inputs, silence.data());
+        createBuffers (buses[1], outputChannels, outputs, discarded.data());
+    }
+
+    // Audio thread: points the patch's channels at the plugin's bus buffers.
+    void connect (aap_buffer_t* buffer, uint32_t numFrames)
+    {
+        for (uint32_t port = 0; port < inputs.size(); ++port)
+        {
+            auto& patchBuffer = inputs[port];
+            auto count = static_cast<uint32_t> (buffer->get_audio_channel_count (buffer, AAP_PORT_DIRECTION_INPUT, static_cast<int32_t> (port)));
+            auto channels = buffer->get_audio_channels (buffer, AAP_PORT_DIRECTION_INPUT, static_cast<int32_t> (port));
+
+            for (uint32_t c = 0; c < patchBuffer.channel_count; ++c)
+                patchBuffer.data32[c] = c < count ? channels[c] : silence.data();
+
+            if (port == 0 && patchBuffer.channel_count == 1 && count >= 2)
+            {
+                for (uint32_t i = 0; i < numFrames; ++i)
+                    monoMix[i] = 0.5f * (channels[0][i] + channels[1][i]);
+
+                patchBuffer.data32[0] = monoMix.data();
+            }
+            else if (port == 0 && patchBuffer.channel_count >= 2 && count == 1)
+            {
+                patchBuffer.data32[1] = channels[0];
+            }
+        }
+
+        for (uint32_t port = 0; port < outputs.size(); ++port)
+        {
+            auto& patchBuffer = outputs[port];
+            auto count = static_cast<uint32_t> (buffer->get_audio_channel_count (buffer, AAP_PORT_DIRECTION_OUTPUT, static_cast<int32_t> (port)));
+            auto channels = buffer->get_audio_channels (buffer, AAP_PORT_DIRECTION_OUTPUT, static_cast<int32_t> (port));
+
+            for (uint32_t c = 0; c < patchBuffer.channel_count; ++c)
+                patchBuffer.data32[c] = c < count ? channels[c] : discarded.data();
+        }
+    }
+
+    // Audio thread: fills the plugin's output channels that the patch didn't write to
+    // (a mono main output is copied to the other channels of the main bus).
+    void completeOutput (aap_buffer_t* buffer, uint32_t numFrames)
+    {
+        for (int32_t port = 0, n = buffer->get_bus_count (buffer, AAP_BUS_KIND_AUDIO, AAP_PORT_DIRECTION_OUTPUT); port < n; ++port)
+        {
+            auto count = static_cast<uint32_t> (buffer->get_audio_channel_count (buffer, AAP_PORT_DIRECTION_OUTPUT, port));
+            auto channels = buffer->get_audio_channels (buffer, AAP_PORT_DIRECTION_OUTPUT, port);
+            auto written = static_cast<size_t> (port) < outputs.size() ? outputs[static_cast<size_t> (port)].channel_count : 0u;
+
+            for (uint32_t c = written; c < count; ++c)
+            {
+                if (port == 0 && written == 1)
+                    std::copy_n (channels[0], numFrames, channels[c]);
+                else
+                    std::fill_n (channels[c], numFrames, 0.0f);
+            }
+        }
+    }
+
+    uint32_t maxFrames = 0;
+    std::vector<clap_audio_buffer_t> inputs, outputs;
+    // The patch's audio ports as AAP audio buses (0: input, 1: output).
+    std::array<std::vector<AudioBusInfo>, 2> buses;
+
+private:
+    std::vector<float*> inputChannels, outputChannels;
+    std::vector<float> silence, discarded, monoMix;
+};
+
+//==============================================================================
+// One patch, run by its own cmajor CLAP plugin. A Wrapper switches patches by replacing its
+// LoadedPatch as a whole.
+struct LoadedPatch
+{
+    LoadedPatch (std::string identityToUse, const PatchLocation& location, PatchDescription descriptionToUse)
+        : identity (std::move (identityToUse)),
+          description (std::move (descriptionToUse)),
+          buildLog (std::make_shared<BuildLog>()),
+          plugin (cmaj::plugin::clap::create (sharedDescriptor, sharedHost, location.manifestFile,
+                                              createEnvironment (location, [log = buildLog] (const auto& status) { log->update (status); })))
+    {
+        if (plugin != nullptr)
+            initialised = plugin->init (plugin.get());
+    }
+
+    // Only ever called on the main thread (see retirePatch()).
+    ~LoadedPatch()
+    {
+        if (plugin == nullptr)
+            return;
+
+        deactivate();
+        closeEditor();
+    }
+
+    bool isValid() const  { return plugin != nullptr && initialised; }
+
+    //==============================================================================
+    // The JIT engine only builds the patch (and so only knows its parameters and audio ports)
+    // when the CLAP plugin is activated. AAP's activate()/deactivate() must be realtime-safe,
+    // so the CLAP plugin starts processing right away, and the AAP side is gated in process().
+    bool activate (double sampleRate, uint32_t maxFrames)
+    {
+        deactivate();
+
+        if (! plugin->activate (plugin.get(), sampleRate, 1, maxFrames))
+            return false;
+
+        if (! plugin->start_processing (plugin.get()))
+        {
+            plugin->deactivate (plugin.get());
+            return false;
+        }
+
+        active = true;
+        audioRouting.build (*plugin, maxFrames);
+        return true;
+    }
+
+    void deactivate()
+    {
+        if (! active)
+            return;
+
+        plugin->stop_processing (plugin.get());
+        plugin->deactivate (plugin.get());
+        active = false;
+    }
+
+    std::string getBuildError() const
+    {
+        auto error = buildLog->getLastError();
+        return error.empty() ? "Could not build " + description.name : error;
+    }
+
+    //==============================================================================
+    std::unique_ptr<ParameterTable> createParameterTable() const
+    {
+        auto table = std::make_unique<ParameterTable>();
+
+        if (auto params = static_cast<const clap_plugin_params_t*> (plugin->get_extension (plugin.get(), CLAP_EXT_PARAMS)))
+        {
+            auto count = std::min<uint32_t> (params->count (plugin.get()), 16384);
+
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                clap_param_info_t info {};
+
+                if (params->get_info (plugin.get(), i, std::addressof (info)))
+                {
+                    table->indexByID[info.id] = static_cast<uint16_t> (table->infos.size());
+                    table->infos.push_back (info);
+                }
+            }
+        }
+
+        return table;
+    }
+
+    //==============================================================================
+    // cmajor's own state of the patch (its parameter values and stored values), as JSON.
+    std::optional<std::string> saveState() const
+    {
+        auto state = static_cast<const clap_plugin_state_t*> (plugin->get_extension (plugin.get(), CLAP_EXT_STATE));
+
+        if (state == nullptr)
+            return {};
+
+        std::string result;
+
+        clap_ostream_t stream
+        {
+            std::addressof (result),
+            [] (const clap_ostream_t* s, const void* data, uint64_t size) -> int64_t
+            {
+                static_cast<std::string*> (s->ctx)->append (static_cast<const char*> (data), static_cast<size_t> (size));
+                return static_cast<int64_t> (size);
+            }
+        };
+
+        if (! state->save (plugin.get(), std::addressof (stream)))
+            return {};
+
+        return result;
+    }
+
+    // If the patch hasn't been built yet, cmajor applies the state once it is.
+    bool loadState (const std::string& data)
+    {
+        auto state = static_cast<const clap_plugin_state_t*> (plugin->get_extension (plugin.get(), CLAP_EXT_STATE));
+
+        if (state == nullptr || data.empty())
+            return false;
+
+        struct Reader
+        {
+            const std::string& data;
+            size_t position = 0;
+        };
+
+        Reader reader { data };
+
+        clap_istream_t stream
+        {
+            std::addressof (reader),
+            [] (const clap_istream_t* s, void* buffer, uint64_t size) -> int64_t
+            {
+                auto& r = *static_cast<Reader*> (s->ctx);
+                auto count = static_cast<size_t> (std::min<uint64_t> (size, r.data.size() - r.position));
+                std::memcpy (buffer, r.data.data() + r.position, count);
+                r.position += count;
+                return static_cast<int64_t> (count);
+            }
+        };
+
+        return state->load (plugin.get(), std::addressof (stream));
+    }
+
+    //==============================================================================
+    // GUI (main thread only)
+    bool attachEditor (jobject parentViewGroup, double scale)
+    {
+        closeEditor();
+
+        auto gui = getGUI();
+
+        if (gui == nullptr || ! gui->create (plugin.get(), CMAJ_CLAP_WINDOW_API_ANDROID, false))
+            return false;
+
+        gui->set_scale (plugin.get(), scale);
+
+        clap_window_t window {};
+        window.api = CMAJ_CLAP_WINDOW_API_ANDROID;
+        window.ptr = parentViewGroup;
+
+        if (! gui->set_parent (plugin.get(), std::addressof (window)))
+        {
+            gui->destroy (plugin.get());
+            return false;
+        }
+
+        gui->show (plugin.get());
+        editorOpen = true;
+        return true;
+    }
+
+    void closeEditor()
+    {
+        if (! editorOpen)
+            return;
+
+        if (auto gui = getGUI())
+            gui->destroy (plugin.get());
+
+        editorOpen = false;
+    }
+
+    const clap_plugin_gui_t* getGUI() const
+    {
+        return static_cast<const clap_plugin_gui_t*> (plugin->get_extension (plugin.get(), CLAP_EXT_GUI));
+    }
+
+    //==============================================================================
+    const std::string identity;
+    const PatchDescription description;
+    std::shared_ptr<BuildLog> buildLog;
+    cmaj::plugin::clap::PluginPtr plugin;
+
+    bool initialised = false;
+    bool active = false;
+    std::atomic<bool> editorOpen { false };
+
+    AudioRouting audioRouting;
+};
+
+// Patches are destroyed on the main thread, since their WebView must be, and their patch worker's
+// JavaScript timers run there. The posted function, and the patch with it, is deleted there too.
+inline void retirePatch (std::unique_ptr<LoadedPatch> patch)
+{
+    if (patch == nullptr || choc::messageloop::callerIsOnMessageThread())
+        return;
+
+    choc::messageloop::postMessage ([p = std::shared_ptr<LoadedPatch> (std::move (patch))] {});
+}
+
+//==============================================================================
+// One AAP plugin instance. It always has a patch identity (Pro54 at first), but only builds
+// the patch once it knows the sample rate and block size, i.e. at prepare(); until then,
+// `current` is null.
+//
+// Locking (always in this order): loadMutex serialises building patches, which can take
+// seconds; patchMutex guards switching `current` and everything the UI reads, and is only
+// held briefly; processMutex is held by process(), and the audio thread only ever try-locks
+// it, outputting silence for the few blocks during which a patch is being switched.
+struct Wrapper
+{
+    Wrapper (const PluginDescriptor& descriptorToUse, AndroidAudioPluginHost* hostToUse)
+        : descriptor (descriptorToUse), aapHost (hostToUse), currentIdentity (descriptor.defaultPatchIdentity),
+          reportedBuses (getDefaultBuses (descriptorToUse))
+    {
+        if (auto location = resolvePatchIdentity (currentIdentity))
+            currentDescription = describePatch (*location);
+
+        publishParameterTable (std::make_unique<ParameterTable>());
+    }
+
+    ~Wrapper()
+    {
+        retirePatch (std::move (current));
+    }
+
+    // The audio buses that the plugin reports (0: input, 1: output).
+    std::array<std::vector<AudioBusInfo>, 2> getBuses()
+    {
+        std::lock_guard<std::mutex> lock (busesMutex);
+        return reportedBuses;
+    }
+
+    //==============================================================================
+    // Switches to the patch, building it if the plugin has been prepared. It blocks for as long
+    // as building takes, so call it from a background thread where possible; the current patch
+    // keeps playing in the meantime. If the patch can't be loaded, `keepCurrentPatchOnFailure`
+    // decides whether to keep the current patch, or to switch to having none.
+    // Returns an error message, or an empty string on success.
+    std::string loadPatch (const std::string& identity, std::optional<std::string> cmajorState, bool keepCurrentPatchOnFailure)
+    {
+        std::lock_guard<std::mutex> loadLock (loadMutex);
+
+        auto location = resolvePatchIdentity (identity);
+        auto description = location ? describePatch (*location) : std::nullopt;
+        std::string error;
+        std::unique_ptr<LoadedPatch> next;
+
+        if (! description)
+            error = "Patch not found: " + identity;
+        else if (prepared)
+            next = buildPatch (identity, *location, *description, cmajorState, error);
+
+        if (! error.empty() && keepCurrentPatchOnFailure)
+        {
+            std::lock_guard<std::mutex> patchLock (patchMutex);
+            lastError = error;
+            ++revision;
+            return error;
+        }
+
+        publish (std::move (next), identity, std::move (description), std::move (cmajorState), error);
+        return error;
+    }
+
+    // (Re)builds the current patch for the new sample rate and block size, carrying its state over.
+    void prepare (double newSampleRate, uint32_t newMaxFrames)
+    {
+        std::lock_guard<std::mutex> loadLock (loadMutex);
+
+        if (prepared && sampleRate == newSampleRate && maxFrames == newMaxFrames && current != nullptr)
+            return;
+
+        sampleRate = newSampleRate;
+        maxFrames = newMaxFrames;
+        prepared = true;
+
+        std::string identity;
+        std::optional<PatchDescription> description;
+        std::optional<std::string> state;
+
+        {
+            std::lock_guard<std::mutex> patchLock (patchMutex);
+            identity = currentIdentity;
+            description = currentDescription;
+            state = current != nullptr ? current->saveState() : pendingState;
+        }
+
+        auto location = resolvePatchIdentity (identity);
+        std::string error;
+        std::unique_ptr<LoadedPatch> next;
+
+        if (! location || ! description)
+            error = "Patch not found: " + identity;
+        else
+            next = buildPatch (identity, *location, *description, state, error);
+
+        publish (std::move (next), identity, std::move (description), std::move (state), error);
+    }
+
+    //==============================================================================
+    std::string getState()
+    {
+        std::lock_guard<std::mutex> patchLock (patchMutex);
+        auto cmajorState = current != nullptr ? current->saveState() : pendingState;
+
+        auto state = choc::value::createObject ({},
+                                                "aapCmajorStateVersion", 1,
+                                                "patch", currentIdentity);
+
+        if (cmajorState)
+            state.addMember ("cmajorState", *cmajorState);
+
+        return choc::json::toString (state, false);
+    }
+
+    void setState (std::string_view serialised)
+    {
+        std::string identity;
+        std::optional<std::string> cmajorState;
+
+        try
+        {
+            auto state = choc::json::parse (serialised);
+
+            if (! state.isObject() || ! state["patch"].isString())
+                return;
+
+            identity = std::string (state["patch"].getString());
+
+            if (state["cmajorState"].isString())
+                cmajorState = std::string (state["cmajorState"].getString());
+        }
+        catch (...)
+        {
+            return;
+        }
+
+        {
+            std::lock_guard<std::mutex> patchLock (patchMutex);
+
+            if (current != nullptr && current->identity == identity)
+            {
+                if (cmajorState)
+                    current->loadState (*cmajorState);
+
+                return;
+            }
+        }
+
+        // A restored state shouldn't sound like a different patch, so if the patch can't be
+        // loaded, the plugin goes silent (still remembering the patch and its state).
+        loadPatch (identity, std::move (cmajorState), false);
+    }
+
+    // get_state_size() and get_state() are separate calls, between which the state may change.
+    // get_state() always saves the latest state, but if that doesn't fit into the space the host
+    // allocated for the size it was told, it falls back to the state saved for get_state_size().
+    size_t getStateSize()
+    {
+        auto state = getState();
+        std::lock_guard<std::mutex> l (stateForSizeMutex);
+        stateForSize = std::move (state);
+        return stateForSize.size();
+    }
+
+    void getState (aap_state_t& destination)
+    {
+        auto state = getState();
+
+        {
+            std::lock_guard<std::mutex> l (stateForSizeMutex);
+
+            if (state.size() > destination.data_size && ! stateForSize.empty() && stateForSize.size() <= destination.data_size)
+                state = stateForSize;
+
+            stateForSize.clear();
+        }
+
+        auto size = std::min (state.size(), destination.data_size);
+        std::memcpy (destination.data, state.data(), size);
+        destination.data_size = size;
+    }
+
+    //==============================================================================
+    // UI support (main thread)
+
+    // Returns the generation of the patch whose editor was attached, or -1 if there's no editor.
+    int32_t attachEditor (jobject parentViewGroup, double scale)
+    {
+        std::lock_guard<std::mutex> patchLock (patchMutex);
+
+        if (current == nullptr || ! current->attachEditor (parentViewGroup, scale))
+            return -1;
+
+        return static_cast<int32_t> (generation);
+    }
+
+    // Once the patch has been switched, the old patch's editor is closed by retirePatch().
+    void detachEditor (int32_t editorGeneration)
+    {
+        std::lock_guard<std::mutex> patchLock (patchMutex);
+
+        if (current != nullptr && static_cast<int32_t> (generation) == editorGeneration)
+            current->closeEditor();
+    }
+
+    std::optional<std::array<uint32_t, 2>> getViewSize()
+    {
+        std::lock_guard<std::mutex> patchLock (patchMutex);
+        return currentDescription ? currentDescription->viewSize : std::nullopt;
+    }
+
+    // `generation` changes whenever the patch changes, `revision` whenever anything here does.
+    std::string getStatus()
+    {
+        std::lock_guard<std::mutex> patchLock (patchMutex);
+
+        auto status = choc::value::createObject ({},
+                                                 "identity", currentIdentity,
+                                                 "loaded", current != nullptr,
+                                                 "building", building.load(),
+                                                 "error", lastError,
+                                                 "generation", static_cast<int64_t> (generation),
+                                                 "revision", static_cast<int64_t> (revision),
+                                                 "parameterCount", static_cast<int32_t> (getParameterTable()->infos.size()));
+
+        if (currentDescription)
+        {
+            status.addMember ("name", currentDescription->name);
+            status.addMember ("hasView", currentDescription->viewSize.has_value());
+        }
+
+        return choc::json::toString (status, false);
+    }
+
+    //==============================================================================
+    const ParameterTable* getParameterTable() const  { return parameterTable.load (std::memory_order_acquire); }
+
+    const PluginDescriptor& descriptor;
+    AndroidAudioPluginHost* aapHost;
+    std::atomic<bool> released { false };
+    std::atomic<bool> hostActive { false };
+
+    std::mutex processMutex;
+    std::unique_ptr<LoadedPatch> current;
+
+    // audio thread only: events found in the current block's MIDI2 input
+    std::array<InputEvent, 256> pendingEvents {};
+    uint32_t numPendingEvents = 0;
+
+    // audio thread only: the current block's MIDI2 output
+    AAPMidiBufferHeader* midiOut = nullptr;
+    uint32_t midiOutCapacity = 0;
+
+private:
+    //==============================================================================
+    // Creates the patch and builds it (which compiles it, and takes a while).
+    std::unique_ptr<LoadedPatch> buildPatch (const std::string& identity, const PatchLocation& location, const PatchDescription& description,
+                                             const std::optional<std::string>& cmajorState, std::string& error)
+    {
+        building = true;
+        auto patch = std::make_unique<LoadedPatch> (identity, location, description);
+
+        // A state that cmajor can't apply just leaves the patch at its defaults.
+        if (patch->isValid() && cmajorState)
+            patch->loadState (*cmajorState);
+
+        if (! patch->isValid())
+            error = "Could not create " + description.name;
+        else if (! patch->activate (sampleRate, maxFrames))
+            error = patch->getBuildError();
+
+        building = false;
+
+        if (! error.empty())
+        {
+            retirePatch (std::move (patch));
+            return {};
+        }
+
+        return patch;
+    }
+
+    // Makes `next` (null meaning none) the current patch, retiring the previous one. Until the
+    // plugin is prepared there's never a `next`, and only the patch to build at prepare() is set.
+    void publish (std::unique_ptr<LoadedPatch> next, const std::string& identity, std::optional<PatchDescription> description,
+                  std::optional<std::string> cmajorState, const std::string& error)
+    {
+        auto table = next != nullptr ? next->createParameterTable() : std::make_unique<ParameterTable>();
+
+        {
+            std::lock_guard<std::mutex> patchLock (patchMutex);
+
+            {
+                std::lock_guard<std::mutex> processLock (processMutex);
+                std::swap (current, next);
+                publishParameterTable (std::move (table));
+            }
+
+            currentIdentity = identity;
+            currentDescription = std::move (description);
+            pendingState = current != nullptr ? std::nullopt : std::move (cmajorState);
+            lastError = error;
+            ++generation;
+            ++revision;
+        }
+
+        notifyParameterLayoutChanged();
+        updateBusLayout();
+        retirePatch (std::move (next));
+    }
+
+    // The bus layout follows the current patch; the host prepares again when it changes.
+    void updateBusLayout()
+    {
+        std::array<std::vector<AudioBusInfo>, 2> buses;
+
+        {
+            std::lock_guard<std::mutex> patchLock (patchMutex);
+            buses = current != nullptr ? current->audioRouting.buses : getDefaultBuses (descriptor);
+        }
+
+        {
+            std::lock_guard<std::mutex> lock (busesMutex);
+
+            if (buses == reportedBuses)
+                return;
+
+            reportedBuses = std::move (buses);
+        }
+
+        if (released || aapHost == nullptr || aapHost->get_extension == nullptr)
+            return;
+
+        if (auto ext = static_cast<aap_buses_host_extension_t*> (aapHost->get_extension (aapHost, AAP_BUSES_EXTENSION_URI)))
+            if (ext->notify_buses_changed != nullptr)
+                ext->notify_buses_changed (ext, aapHost, AAP_BUSES_CHANGED_LAYOUT);
+    }
+
+    // Published tables are never freed while the plugin is alive, since the host may be
+    // reading the previous one on another thread (and the audio thread reads it lock-free).
+    void publishParameterTable (std::unique_ptr<ParameterTable> table)
+    {
+        std::lock_guard<std::mutex> lock (parameterTablesMutex);
+        parameterTable.store (table.get(), std::memory_order_release);
+        parameterTables.push_back (std::move (table));
+    }
+
+    void notifyParameterLayoutChanged()
+    {
+        if (released || aapHost == nullptr || aapHost->get_extension == nullptr)
+            return;
+
+        if (auto ext = static_cast<aap_parameters_host_extension_t*> (aapHost->get_extension (aapHost, AAP_PARAMETERS_EXTENSION_URI)))
+            if (ext->notify_parameters_changed != nullptr)
+                ext->notify_parameters_changed (ext, aapHost);
+    }
+
+    //==============================================================================
+    std::mutex loadMutex;
+    bool prepared = false;
+    double sampleRate = 0;
+    uint32_t maxFrames = 0;
+    std::atomic<bool> building { false };
+
+    std::mutex busesMutex;
+    std::array<std::vector<AudioBusInfo>, 2> reportedBuses;
+
+    std::mutex patchMutex;
+    std::string currentIdentity;
+    std::optional<PatchDescription> currentDescription;
+    std::optional<std::string> pendingState; // the state to apply to the patch once it's built
+    std::string lastError;
+    uint32_t generation = 0, revision = 0;
+
+    std::mutex stateForSizeMutex;
+    std::string stateForSize;
+
+    std::mutex parameterTablesMutex;
+    std::vector<std::unique_ptr<ParameterTable>> parameterTables;
+    std::atomic<const ParameterTable*> parameterTable { nullptr };
+};
+
+// AAP's plugin_specific holds a shared pointer to the Wrapper, so that a JNI call working on it
+// (see findWrapper()) keeps it alive even if the instance is released meanwhile.
+using WrapperHolder = std::shared_ptr<Wrapper>;
+static std::mutex wrapperHoldersMutex;
+
+inline Wrapper& getWrapper (AndroidAudioPlugin* plugin)  { return **static_cast<WrapperHolder*> (plugin->plugin_specific); }
+
+//==============================================================================
+void aapPrepare (AndroidAudioPlugin* plugin, int32_t sampleRate, aap_buffer_t* buffer)
+{
+    getWrapper (plugin).prepare (static_cast<double> (sampleRate), static_cast<uint32_t> (buffer->num_frames (buffer)));
+}
+
+void aapActivate (AndroidAudioPlugin* plugin)
+{
+    getWrapper (plugin).hostActive = true;
+}
