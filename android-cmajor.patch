+//==============================================================================
+inline uint32_t getUmpSizeInBytes (uint32_t firstWord)
+{
+    switch (firstWord >> 28)
+    {
+        case 0x0: case 0x1: case 0x2: case 0x6: case 0x7:   return 4;
+        case 0x3: case 0x4: case 0x8: case 0x9: case 0xA:   return 8;
+        case 0xB: case 0xC:                                  return 12;
+        default:                                             return 16;
+    }
+}
+
+// Converts a MIDI 1.0 or MIDI 2.0 channel voice UMP into MIDI 1.0 bytes.
+inline bool toMidi1Message (const uint32_t* ump, std::array<uint8_t, 3>& bytes)
+{
+    auto messageType = ump[0] >> 28;
+    auto status = static_cast<uint8_t> ((ump[0] >> 16) & 0xFF);
+    auto data1 = static_cast<uint8_t> ((ump[0] >> 8) & 0x7F);
+
+    if (messageType == 0x2)
+    {
+        bytes = { status, data1, static_cast<uint8_t> (ump[0] & 0x7F) };
+        return true;
+    }
+
+    if (messageType != 0x4)
+        return false;
+
+    auto sevenBitData = static_cast<uint8_t> (ump[1] >> 25);
+
+    switch (status >> 4)
+    {
+        case 0x8: case 0xA: case 0xB:
+            bytes = { status, data1, sevenBitData };
+            return true;
+
+        case 0x9: // a MIDI 2.0 note-on with zero velocity is still a note-on
+            bytes = { status, data1, std::max<uint8_t> (sevenBitData, 1) };
+            return true;
+
+        case 0xC:
+            bytes = { status, static_cast<uint8_t> ((ump[1] >> 24) & 0x7F), 0 };
+            return true;
+
+        case 0xD:
+            bytes = { status, sevenBitData, 0 };
+            return true;
+
+        case 0xE:
+        {
+            auto bend = ump[1] >> 18;
+            bytes = { status, static_cast<uint8_t> (bend & 0x7F), static_cast<uint8_t> (bend >> 7) };
+            return true;
+        }
+
+        default:
+            return false;
+    }
+}
+
+// Collects the MIDI2 input as CLAP events. AAP parameter SysEx8 messages and MIDI 2.0
+// assignable controllers (NRPN) on channel 0 become parameter changes, other channel
+// voice messages are passed on as MIDI.
+inline void collectInputEvents (Wrapper& wrapper, aap_buffer_t* buffer)
+{
+    wrapper.numPendingEvents = 0;
+
+    auto table = wrapper.getParameterTable();
+    auto header = static_cast<AAPMidiBufferHeader*> (buffer->get_event_buffer (buffer, AAP_PORT_DIRECTION_INPUT, 0));
+
+    if (table == nullptr || header == nullptr)
+        return;
+
+    auto data = reinterpret_cast<const uint8_t*> (header + 1);
+    auto capacity = static_cast<uint32_t> (buffer->get_event_buffer_capacity (buffer, AAP_PORT_DIRECTION_INPUT, 0));
+    auto length = std::min<uint32_t> (header->length, capacity > sizeof (AAPMidiBufferHeader) ? capacity - sizeof (AAPMidiBufferHeader) : 0);
+
+    auto addChange = [&] (uint32_t parameterIndex, uint32_t transportValue)
+    {
+        if (parameterIndex >= table->infos.size() || wrapper.numPendingEvents >= wrapper.pendingEvents.size())
+            return;
+
+        auto& info = table->infos[parameterIndex];
+        auto& event = wrapper.pendingEvents[wrapper.numPendingEvents++].parameter;
+        event = {};
+        event.header.size = sizeof (clap_event_param_value_t);
+        event.header.time = 0;
+        event.header.space_id = CLAP_CORE_EVENT_SPACE_ID;
+        event.header.type = CLAP_EVENT_PARAM_VALUE;
+        event.param_id = info.id;
+        event.cookie = info.cookie;
+        event.note_id = -1;
+        event.port_index = -1;
+        event.channel = -1;
+        event.key = -1;
+        event.value = aapParameterTransportUint32ToPlain (info.min_value, info.max_value, transportValue);
+    };
+
+    auto addMidi = [&] (const std::array<uint8_t, 3>& bytes)
+    {
+        if (wrapper.numPendingEvents >= wrapper.pendingEvents.size())
+            return;
+
+        auto& event = wrapper.pendingEvents[wrapper.numPendingEvents++].midi;
+        event = {};
+        event.header.size = sizeof (clap_event_midi_t);
+        event.header.time = 0;
+        event.header.space_id = CLAP_CORE_EVENT_SPACE_ID;
+        event.header.type = CLAP_EVENT_MIDI;
+        event.port_index = 0;
+        std::copy (bytes.begin(), bytes.end(), event.data);
+    };
+
+    for (uint32_t offset = 0; offset + sizeof (uint32_t) <= length;)
+    {
+        auto ump = reinterpret_cast<const uint32_t*> (data + offset);
+        auto size = getUmpSizeInBytes (ump[0]);
+
+        if (offset + size > length)
+            break;
+
+        if (size == 16)
+        {
+            uint8_t group, channel, key, extra;
+            uint16_t index;
+            uint32_t value;
+
+            if (aapReadMidi2ParameterSysex8 (&group, &channel, &key, &extra, &index, &value, ump[0], ump[1], ump[2], ump[3]))
+                addChange (index, value);
+        }
+        else if ((ump[0] >> 28) == 0x4 && ((ump[0] >> 16) & 0xFF) == 0x30) // assignable controller, channel 0
+        {
+            addChange ((((ump[0] >> 8) & 0x7F) << 7) | (ump[0] & 0x7F), ump[1]);
+        }
+        else if (std::array<uint8_t, 3> bytes; toMidi1Message (ump, bytes))
+        {
+            addMidi (bytes);
+        }
+
+        offset += size;
+    }
+}
+
+inline clap_input_events_t createInputEventQueue (Wrapper& wrapper)
+{
+    return
+    {
+        std::addressof (wrapper),
+        [] (const clap_input_events_t* list) -> uint32_t
+        {
+            return static_cast<Wrapper*> (list->ctx)->numPendingEvents;
+        },
+        [] (const clap_input_events_t* list, uint32_t index) -> const clap_event_header_t*
+        {
+            auto& wrapper = *static_cast<Wrapper*> (list->ctx);
+            return index < wrapper.numPendingEvents ? std::addressof (wrapper.pendingEvents[index].header) : nullptr;
+        }
+    };
+}
+
+//==============================================================================
+// The plugin writes the whole MIDI2 output of each block, starting from empty.
+inline void beginMidiOutput (Wrapper& wrapper, aap_buffer_t* buffer)
+{
+    wrapper.midiOut = nullptr;
+    wrapper.midiOutCapacity = 0;
+
+    auto header = static_cast<AAPMidiBufferHeader*> (buffer->get_event_buffer (buffer, AAP_PORT_DIRECTION_OUTPUT, 0));
+    auto size = static_cast<uint32_t> (buffer->get_event_buffer_capacity (buffer, AAP_PORT_DIRECTION_OUTPUT, 0));
+
+    if (header == nullptr || size <= sizeof (AAPMidiBufferHeader))
+        return;
+
+    header->length = 0;
+    wrapper.midiOut = header;
+    wrapper.midiOutCapacity = size - sizeof (AAPMidiBufferHeader);
+}
+
+// Parameter changes that the plugin reports (e.g. those made in its editor) are sent to the
+// host as AAP parameter SysEx8.
+inline bool writeOutputEvent (Wrapper& wrapper, const clap_event_header_t& event)
+{
+    auto table = wrapper.getParameterTable();
+
+    if (event.space_id != CLAP_CORE_EVENT_SPACE_ID || event.type != CLAP_EVENT_PARAM_VALUE
+         || table == nullptr || wrapper.midiOut == nullptr)
+        return false;
+
+    auto& change = reinterpret_cast<const clap_event_param_value_t&> (event);
+    auto found = table->indexByID.find (change.param_id);
+
+    if (found == table->indexByID.end() || wrapper.midiOut->length + 16 > wrapper.midiOutCapacity)
+        return false;
+
+    auto index = found->second;
+    auto& info = table->infos[index];
+    auto ump = reinterpret_cast<uint32_t*> (reinterpret_cast<uint8_t*> (wrapper.midiOut + 1) + wrapper.midiOut->length);
+    aapMidi2ParameterSysex8 (ump, ump + 1, ump + 2, ump + 3, 0, 0, 0, 0, index,
+                             aapParameterPlainToTransportUint32 (info.min_value, info.max_value, change.value));
+    wrapper.midiOut->length += 16;
+    return true;
+}
+
+inline clap_output_events_t createOutputEventQueue (Wrapper& wrapper)
+{
+    return
+    {
+        std::addressof (wrapper),
+        [] (const clap_output_events_t* list, const clap_event_header_t* event) -> bool
+        {
+            return event != nullptr && writeOutputEvent (*static_cast<Wrapper*> (list->ctx), *event);
+        }
+    };
+}
+
+inline void clearAudioOutputs (aap_buffer_t* buffer, uint32_t numFrames)
+{
+    for (int32_t bus = 0, n = buffer->get_bus_count (buffer, AAP_BUS_KIND_AUDIO, AAP_PORT_DIRECTION_OUTPUT); bus < n; ++bus)
+    {
+        auto channels = buffer->get_audio_channels (buffer, AAP_PORT_DIRECTION_OUTPUT, bus);
+
+        for (int32_t c = 0, nc = buffer->get_audio_channel_count (buffer, AAP_PORT_DIRECTION_OUTPUT, bus); c < nc; ++c)
+            std::fill_n (channels[c], numFrames, 0.0f);
+    }
+}
+
+void aapProcess (AndroidAudioPlugin* plugin, aap_buffer_t* buffer, int32_t frameCount, int64_t)
+{
+    auto& wrapper = getWrapper (plugin);
+    auto numFrames = static_cast<uint32_t> (frameCount);
+
+    beginMidiOutput (wrapper, buffer);
+
+    // Never wait for a patch switch to finish - output silence instead.
+    std::unique_lock<std::mutex> lock (wrapper.processMutex, std::try_to_lock);
+    auto patch = lock.owns_lock() ? wrapper.current.get() : nullptr;
+
+    if (patch == nullptr || ! patch->active || ! wrapper.hostActive || numFrames > patch->audioRouting.maxFrames)
+    {
+        clearAudioOutputs (buffer, numFrames);
+        return;
+    }
+
+    collectInputEvents (wrapper, buffer);
+
+    auto& routing = patch->audioRouting;
+    routing.connect (buffer, numFrames);
+
+    auto inputEvents = createInputEventQueue (wrapper);
+    auto outputEvents = createOutputEventQueue (wrapper);
+
+    const clap_process_t process
+    {
+        -1,
+        numFrames,
+        nullptr,
+        routing.inputs.data(),
+        routing.outputs.data(),
+        static_cast<uint32_t> (routing.inputs.size()),
+        static_cast<uint32_t> (routing.outputs.size()),
+        std::addressof (inputEvents),
+        std::addressof (outputEvents)
+    };
+
+    patch->plugin->process (patch->plugin.get(), std::addressof (process));
+    routing.completeOutput (buffer, numFrames);
+}
+
+void aapDeactivate (AndroidAudioPlugin* plugin)
+{
+    getWrapper (plugin).hostActive = false;
+}
+
+//==============================================================================
+static aap_parameters_extension_t parametersExtension
+{
+    nullptr,
+    [] (aap_parameters_extension_t*, AndroidAudioPlugin* plugin) -> int32_t
+    {
+        auto table = getWrapper (plugin).getParameterTable();
+        return table != nullptr ? static_cast<int32_t> (table->infos.size()) : 0;
+    },
+    [] (aap_parameters_extension_t*, AndroidAudioPlugin* plugin, int32_t index) -> aap_parameter_info_t
+    {
+        aap_parameter_info_t result {};
+        auto table = getWrapper (plugin).getParameterTable();
+
+        if (table == nullptr || index < 0 || index >= static_cast<int32_t> (table->infos.size()))
+            return result;
+
+        auto& info = table->infos[static_cast<size_t> (index)];
+        result.stable_id = static_cast<int16_t> (index);
+        std::snprintf (result.display_name, sizeof (result.display_name), "%s", info.name);
+        std::snprintf (result.path, sizeof (result.path), "%s", info.module);
+        result.min_value = info.min_value;
+        result.max_value = info.max_value;
+        result.default_value = info.default_value;
+        result.per_note_enabled = false;
+        return result;
+    },
+    [] (aap_parameters_extension_t*, AndroidAudioPlugin*, int32_t, int32_t) -> double { return 0; },
+    [] (aap_parameters_extension_t*, AndroidAudioPlugin*, int32_t) -> int32_t { return 0; },
+    [] (aap_parameters_extension_t*, AndroidAudioPlugin*, int32_t, int32_t) -> aap_parameter_enum_t { return {}; }
+};
+
+static aap_state_extension_t stateExtension
+{
+    nullptr,
+    [] (aap_state_extension_t*, AndroidAudioPlugin* plugin) -> size_t
+    {
+        return getWrapper (plugin).getStateSize();
+    },
+    [] (aap_state_extension_t*, AndroidAudioPlugin* plugin, aap_state_t* destination)
+    {
+        if (destination != nullptr && destination->data != nullptr)
+            getWrapper (plugin).getState (*destination);
+    },
+    [] (aap_state_extension_t*, AndroidAudioPlugin* plugin, aap_state_t* source)
+    {
+        if (source != nullptr && source->data != nullptr)
+            getWrapper (plugin).setState ({ static_cast<const char*> (source->data), source->data_size });
+    }
+};
+
+static aap_buses_extension_t busesExtension
+{
+    nullptr,
+    [] (aap_buses_extension_t*, AndroidAudioPlugin* plugin, aap_bus_kind kind, aap_port_direction direction) -> int32_t
+    {
+        return kind == AAP_BUS_KIND_AUDIO ? static_cast<int32_t> (getWrapper (plugin).getBuses()[direction == AAP_PORT_DIRECTION_INPUT ? 0 : 1].size()) : 0;
+    },
+    [] (aap_buses_extension_t*, AndroidAudioPlugin* plugin, aap_bus_kind kind, aap_port_direction direction, int32_t index) -> aap_bus_info_t
+    {
+        aap_bus_info_t info {};
+        auto buses = getWrapper (plugin).getBuses()[direction == AAP_PORT_DIRECTION_INPUT ? 0 : 1];
+
+        if (kind != AAP_BUS_KIND_AUDIO || index < 0 || static_cast<size_t> (index) >= buses.size())
+            return info;
+
+        auto& bus = buses[static_cast<size_t> (index)];
+        info.id = bus.id;
+        info.kind = AAP_BUS_KIND_AUDIO;
+        info.direction = direction;
+        info.role = index == 0 ? AAP_BUS_ROLE_MAIN : AAP_BUS_ROLE_AUX;
+        std::strncpy (info.name, bus.name.c_str(), AAP_MAX_BUS_NAME_CHARS - 1);
+        info.channel_count = static_cast<int32_t> (bus.channelCount);
+        std::strncpy (info.layout, bus.layout.c_str(), AAP_MAX_BUS_LAYOUT_CHARS - 1);
+        info.enabled = true;
+        return info;
+    },
+    nullptr // the layout is the patch's own one
+};
+
+void* aapGetExtension (AndroidAudioPlugin*, const char* uri)
+{
+    if (std::strcmp (uri, AAP_PARAMETERS_EXTENSION_URI) == 0)
+        return std::addressof (parametersExtension);
+
+    if (std::strcmp (uri, AAP_BUSES_EXTENSION_URI) == 0)
+        return std::addressof (busesExtension);
+
+    if (std::strcmp (uri, AAP_STATE_EXTENSION_URI) == 0)
+        return std::addressof (stateExtension);
+
+    return nullptr;
+}
+
+// The host knows the actual ports, which follow the bus layout.
+aap_plugin_info_t aapGetPluginInfo (AndroidAudioPlugin* plugin)
+{
+    auto& wrapper = getWrapper (plugin);
+    auto host = wrapper.aapHost;
+    auto ext = static_cast<aap_host_plugin_info_extension_t*> (host->get_extension (host, AAP_PLUGIN_INFO_EXTENSION_URI));
+    return ext != nullptr ? ext->get (ext, host, wrapper.descriptor.pluginID) : aap_plugin_info_t {};
+}
+
+// choc's Android backend (used e.g. by cmaj::Patch to post parameter change notifications to
+// the main thread) needs the JavaVM and the application context. Our library is dlopen()-ed by
+// aap-core rather than loaded by System.loadLibrary(), so JNI_OnLoad() is never invoked; we get
+// them from aap-core instead.
+inline void initialiseChocForAndroid()
+{
+    static std::once_flag once;
+
+    std::call_once (once, []
+    {
+        auto vm = ::aap::get_android_jvm();
+        auto context = ::aap::get_android_application_context();
+
+        if (vm == nullptr || context == nullptr)
+            return;
+
+        JNIEnv* env = nullptr;
+
+        if (vm->GetEnv (reinterpret_cast<void**> (&env), JNI_VERSION_1_6) == JNI_EDETACHED)
+            vm->AttachCurrentThread (&env, nullptr);
+
+        choc::android::initialise (vm, context);
+    });
+}
+
+AndroidAudioPlugin* aapInstantiate (AndroidAudioPluginFactory*, const char* pluginUniqueId, AndroidAudioPluginHost* host)
+{
+    auto descriptor = pluginUniqueId != nullptr ? findPluginDescriptor (pluginUniqueId) : nullptr;
+
+    if (descriptor == nullptr)
+        return nullptr;
+
+    initialiseChocForAndroid();
+
+    return new AndroidAudioPlugin
+    {
+        new WrapperHolder (std::make_shared<Wrapper> (*descriptor, host)),
+        aapPrepare,
+        aapActivate,
+        aapProcess,
+        aapDeactivate,
+        aapGetExtension,
+        aapGetPluginInfo
+    };
+}
+
+void aapRelease (AndroidAudioPluginFactory*, AndroidAudioPlugin* instance)
+{
+    WrapperHolder wrapper;
+
+    {
+        std::lock_guard<std::mutex> lock (wrapperHoldersMutex);
+        auto holder = static_cast<WrapperHolder*> (instance->plugin_specific);
+        wrapper = std::move (*holder);
+        delete holder;
+        instance->plugin_specific = nullptr;
+    }
+
+    wrapper->released = true;
+    delete instance;
+}
+
+static AndroidAudioPluginFactory factory { aapInstantiate, aapRelease, nullptr };
+
+//==============================================================================
+// Support for CmajorNative.kt, called from the plugin's own UI.
+inline WrapperHolder findWrapper (jlong serviceInstance, jint instanceId)
+{
+    std::lock_guard<std::mutex> lock (wrapperHoldersMutex);
+    auto service = reinterpret_cast<::aap::PluginService*> (serviceInstance);
+    auto instance = service != nullptr ? service->getLocalInstance (instanceId) : nullptr;
+    auto plugin = instance != nullptr ? instance->getPlugin() : nullptr;
+    auto holder = plugin != nullptr ? static_cast<WrapperHolder*> (plugin->plugin_specific) : nullptr;
+    return holder != nullptr ? *holder : nullptr;
+}
+
+inline std::string toString (JNIEnv* env, jstring s)
+{
+    if (s == nullptr)
+        return {};
+
+    auto chars = env->GetStringUTFChars (s, nullptr);
+    std::string result (chars != nullptr ? chars : "");
+    env->ReleaseStringUTFChars (s, chars);
+    return result;
+}
+
+inline jstring toJavaString (JNIEnv* env, const std::string& s)
+{
+    return env->NewStringUTF (s.c_str());
+}
