new file mode 100644
index 0000000..f487734
--- /dev/null
+++ b/choc/gui/android/com/tracktion/choc/ChocMainThread.java
@@ -0,0 +1,34 @@
+/*
+    This is the Java half of choc::messageloop's Android backend (see
+    choc_AndroidMainThread.h and choc_MessageLoop.h's CHOC_ANDROID branch).
+
+    It just wraps an android.os.Handler bound to the main Looper, so that
+    native code can post a token (a pointer to a heap-allocated
+    std::function<void()>) to be run on Android's UI thread. See
+    choc_AndroidMainThread.h for the C++ side of this.
+
+    This must be built into the app alongside com.tracktion.choc.gui.ChocWebView
+    (see that file's header comment for how to wire the source directory into
+    a gradle build).
+*/
+package com.tracktion.choc;
+
+import android.os.Handler;
+import android.os.Looper;
+
+public final class ChocMainThread
+{
+    public static void post (long token)
+    {
+        handler.post (() -> nativeDispatch (token));
+    }
+
+    public static void postDelayed (long token, long delayMillis)
+    {
+        handler.postDelayed (() -> nativeDispatch (token), delayMillis);
+    }
+
+    private static final Handler handler = new Handler (Looper.getMainLooper());
+
+    private static native void nativeDispatch (long token);
+}
diff --git a/choc/gui/android/com/tracktion/choc/gui/ChocWebView.java b/choc/gui/android/com/tracktion/choc/gui/ChocWebView.java
new file mode 100644
index 0000000..6b30058
--- /dev/null
+++ b/choc/gui/android/com/tracktion/choc/gui/ChocWebView.java
@@ -0,0 +1,124 @@
+/*
+    This is the Java half of choc::ui::WebView's Android backend (see
+    choc_AndroidWebViewJNI.h and choc_WebView.h's CHOC_ANDROID branch).
+
+    choc is a header-only C++ library, so it can't ship compiled Java bytecode
+    of its own - a handful of Android APIs (the JS-to-native bridge object,
+    and the WebView evaluateJavascript() callback) can only be implemented by
+    a real, compiled Java class, not by anything JNI can synthesize at
+    runtime. This file is that class. It is intentionally tiny: almost all of
+    the logic lives on the C++ side, and this class just forwards WebView's
+    callbacks to the native* methods below (which are bound to C++ functions
+    via JNI's RegisterNatives(), from choc_AndroidWebViewJNI.h).
+
+    To use choc::ui::WebView on Android, add this file to your app's Java/Kotlin
+    sources, e.g. in a Gradle build:
+
+        android {
+            sourceSets {
+                main {
+                    java.srcDirs += 'path/to/choc/choc/gui/android'
+                }
+            }
+        }
+
+    and call choc::android::initialise (vm, applicationContext) once, from a
+    thread that's already attached to the JVM, before constructing any
+    choc::ui::WebView.
+*/
+package com.tracktion.choc.gui;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Color;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+
+import java.util.ArrayList;
+
+public final class ChocWebView extends WebView
+{
+    public ChocWebView (Context context, long nativeHandle)
+    {
+        super (context);
+
+        this.nativeHandle = nativeHandle;
+
+        getSettings().setJavaScriptEnabled (true);
+        getSettings().setDomStorageEnabled (true);
+
+        setWebViewClient (new WebViewClient()
+        {
+            @Override
+            public void onPageStarted (WebView view, String url, Bitmap favicon)
+            {
+                for (String script : initScripts)
+                    view.evaluateJavascript (script, null);
+            }
+
+            @Override
+            public WebResourceResponse shouldInterceptRequest (WebView view, WebResourceRequest request)
+            {
+                return nativeFetchResource (nativeHandle, request.getUrl().toString());
+            }
+        });
+
+        addJavascriptInterface (this, "chocNative");
+    }
+
+    public void navigate (String url)
+    {
+        loadUrl (url);
+    }
+
+    public void loadHTML (String html, String baseURL)
+    {
+        loadDataWithBaseURL (baseURL, html, "text/html", "utf-8", null);
+    }
+
+    public void addInitScript (String script)
+    {
+        initScripts.add (script);
+    }
+
+    public void runEvaluateJavascript (String script, long callbackToken)
+    {
+        if (callbackToken == 0)
+        {
+            evaluateJavascript (script, null);
+        }
+        else
+        {
+            evaluateJavascript (script, result ->
+                nativeEvaluationResult (nativeHandle, callbackToken, null, result));
+        }
+    }
+
+    public void setChocUserAgent (String userAgent)
+    {
+        if (! userAgent.isEmpty())
+            getSettings().setUserAgentString (userAgent);
+    }
+
+    public void setTransparentBackground (boolean transparent)
+    {
+        setBackgroundColor (transparent ? Color.TRANSPARENT : Color.WHITE);
+    }
+
+    /// Called by the page via `window.chocNative.postMessage (json)`.
+    @JavascriptInterface
+    public void postMessage (String json)
+    {
+        nativePostMessage (nativeHandle, json);
+    }
+
+    private final long nativeHandle;
+    private final ArrayList<String> initScripts = new ArrayList<> ();
+
+    private static native void nativePostMessage (long nativeHandle, String json);
+    private static native void nativeEvaluationResult (long nativeHandle, long callbackToken, String errorMessage, String resultJSON);
+    private static native WebResourceResponse nativeFetchResource (long nativeHandle, String path);
+}
