+//   AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR
+//   CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
+//   WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+//   CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+
+#ifndef CHOC_ANDROID_WEBVIEW_JNI_HEADER_INCLUDED
+#define CHOC_ANDROID_WEBVIEW_JNI_HEADER_INCLUDED
+
+#include "../platform/choc_Platform.h"
+
+#if CHOC_ANDROID
+
+#include <functional>
+#include <optional>
+#include <string>
+#include <vector>
+#include <cstdint>
+#include <iterator>
+
+#include "../platform/choc_AndroidJNIHelpers.h"
+
+//==============================================================================
+/**
+    This namespace wraps up the JNI calls needed to drive an android.webkit.WebView
+    from C++, via a small companion Java class (com.tracktion.choc.gui.ChocWebView).
+
+    choc::ui::WebView's Android backend (in choc_WebView.h) only ever talks to
+    the choc::android::NativeWebView class declared here - it never touches JNI
+    types or calls directly, which keeps all the Android-specific plumbing in
+    this one pair of files (this header, and its Java counterpart).
+
+    The hosting application must have called choc::android::initialise() (see
+    choc_AndroidJNIHelpers.h) before constructing a NativeWebView, and the
+    com.tracktion.choc.gui.ChocWebView.java class must be built into the app
+    (see that file's header comment for how to wire it into a gradle build).
+*/
+namespace choc::android
+{
+
+/// A chunk of resource data returned by a NativeWebView::Callbacks::fetchResource
+/// implementation, mirroring choc::ui::WebView::Options::Resource without this
+/// header needing to depend on choc_WebView.h.
+struct FetchedResource
+{
+    std::vector<uint8_t> data;
+    std::string mimeType;
+};
+
+//==============================================================================
+/// Owns a single android.webkit.WebView (via the ChocWebView Java helper class)
+/// and exposes plain C++ methods for controlling it. All methods must be called
+/// from the same thread that the object was constructed on, which must be
+/// Android's main (UI) thread, since that's a hard requirement of WebView itself.
+class NativeWebView
+{
+public:
+    struct Callbacks
+    {
+        /// Called when the page calls `window.chocNative.postMessage (json)`.
+        std::function<void (const std::string& json)> onPostMessage;
+
+        /// Called with the result of a previous evaluateJavascript() call that
+        /// was given a non-zero callback token. `errorMessage` is empty on success.
+        std::function<void (uint64_t callbackToken, const std::string& errorMessage, const std::string& resultJSON)> onEvaluationResult;
+
+        /// Called (on an arbitrary thread) when the page requests a resource from
+        /// the custom scheme URI. Returning std::nullopt results in a 404.
+        std::function<std::optional<FetchedResource> (const std::string& path)> fetchResource;
+    };
+
+    NativeWebView (Callbacks);
+    ~NativeWebView();
+
+    NativeWebView (const NativeWebView&) = delete;
+
+    /// True if the underlying android.webkit.WebView was created successfully.
+    bool isValid() const noexcept  { return javaView.get() != nullptr; }
+
+    /// Returns the ChocWebView instance (a jobject, i.e. an android.view.View)
+    /// as an opaque pointer, for embedding into the host app's own view hierarchy.
+    void* getViewHandle() const noexcept  { return static_cast<void*> (javaView.get()); }
+
+    void navigate (const std::string& url);
+    void loadHTML (const std::string& html, const std::string& baseURL);
+    void addInitScript (const std::string& script);
+
+    /// If callbackToken is non-zero, Callbacks::onEvaluationResult will later be
+    /// called with that token and the result.
+    void evaluateJavascript (const std::string& script, uint64_t callbackToken);
+
+    void setUserAgent (const std::string&);
+    void setTransparentBackground (bool);
+
+private:
+    //==============================================================================
+    struct JavaBindings
+    {
+        jclass viewClass = {};
+        jmethodID constructor = {};
+        jmethodID navigateMethod = {};
+        jmethodID loadHTMLMethod = {};
+        jmethodID addInitScriptMethod = {};
+        jmethodID evaluateJavascriptMethod = {};
+        jmethodID setUserAgentMethod = {};
+        jmethodID setTransparentBackgroundMethod = {};
+        jmethodID destroyMethod = {};
+    };
+
+    static JavaBindings& getBindings();
+    static void registerNativeCallbacks (JNIEnv&, jclass);
+
+    static void JNICALL nativePostMessage (JNIEnv*, jobject, jlong nativeHandle, jstring json);
+    static void JNICALL nativeEvaluationResult (JNIEnv*, jobject, jlong nativeHandle, jlong token, jstring error, jstring result);
+    static jobject JNICALL nativeFetchResource (JNIEnv*, jobject, jlong nativeHandle, jstring path);
+
+    Callbacks callbacks;
+    GlobalRef<jobject> javaView;
+};
+
+
+//==============================================================================
+//        _        _           _  _
+//     __| |  ___ | |_   __ _ (_)| | ___
+//    / _` | / _ \| __| / _` || || |/ __|
+//   | (_| ||  __/| |_ | (_| || || |\__ \ _  _  _
+//    \__,_| \___| \__| \__,_||_||_||___/(_)(_)(_)
+//
+//   Code beyond this point is implementation detail...
+//
+//==============================================================================
+
+inline NativeWebView::JavaBindings& NativeWebView::getBindings()
+{
+    static JavaBindings bindings = []
+    {
+        auto& env = *getEnv();
+        JavaBindings b;
+
+        auto localClass = findClass (env, "com/tracktion/choc/gui/ChocWebView");
+        b.viewClass = static_cast<jclass> (env.NewGlobalRef (localClass));
+        env.DeleteLocalRef (localClass);
+
+        b.constructor                     = env.GetMethodID (b.viewClass, "<init>", "(Landroid/content/Context;J)V");
+        b.navigateMethod                  = env.GetMethodID (b.viewClass, "navigate", "(Ljava/lang/String;)V");
+        b.loadHTMLMethod                  = env.GetMethodID (b.viewClass, "loadHTML", "(Ljava/lang/String;Ljava/lang/String;)V");
+        b.addInitScriptMethod             = env.GetMethodID (b.viewClass, "addInitScript", "(Ljava/lang/String;)V");
+        b.evaluateJavascriptMethod        = env.GetMethodID (b.viewClass, "runEvaluateJavascript", "(Ljava/lang/String;J)V");
+        b.setUserAgentMethod              = env.GetMethodID (b.viewClass, "setChocUserAgent", "(Ljava/lang/String;)V");
+        b.setTransparentBackgroundMethod  = env.GetMethodID (b.viewClass, "setTransparentBackground", "(Z)V");
+        b.destroyMethod                   = env.GetMethodID (b.viewClass, "destroy", "()V");
+
+        registerNativeCallbacks (env, b.viewClass);
+        checkAndClearException (env);
+        return b;
+    }();
+
+    return bindings;
+}
+
+inline void NativeWebView::registerNativeCallbacks (JNIEnv& env, jclass viewClass)
+{
+    JNINativeMethod methods[] =
+    {
+        { const_cast<char*> ("nativePostMessage"),      const_cast<char*> ("(JLjava/lang/String;)V"),                          reinterpret_cast<void*> (&NativeWebView::nativePostMessage) },
+        { const_cast<char*> ("nativeEvaluationResult"), const_cast<char*> ("(JJLjava/lang/String;Ljava/lang/String;)V"),       reinterpret_cast<void*> (&NativeWebView::nativeEvaluationResult) },
+        { const_cast<char*> ("nativeFetchResource"),    const_cast<char*> ("(JLjava/lang/String;)Landroid/webkit/WebResourceResponse;"), reinterpret_cast<void*> (&NativeWebView::nativeFetchResource) },
+    };
+
+    env.RegisterNatives (viewClass, methods, static_cast<jint> (std::size (methods)));
+}
+
+inline void JNICALL NativeWebView::nativePostMessage (JNIEnv* env, jobject, jlong nativeHandle, jstring json)
+{
+    if (auto* self = reinterpret_cast<NativeWebView*> (nativeHandle))
+        if (self->callbacks.onPostMessage)
+            self->callbacks.onPostMessage (toString (*env, json));
+}
+
+inline void JNICALL NativeWebView::nativeEvaluationResult (JNIEnv* env, jobject, jlong nativeHandle, jlong token, jstring error, jstring result)
+{
+    if (auto* self = reinterpret_cast<NativeWebView*> (nativeHandle))
+        if (self->callbacks.onEvaluationResult)
+            self->callbacks.onEvaluationResult (static_cast<uint64_t> (token), toString (*env, error), toString (*env, result));
+}
+
+inline jobject JNICALL NativeWebView::nativeFetchResource (JNIEnv* env, jobject, jlong nativeHandle, jstring path)
+{
+    auto* self = reinterpret_cast<NativeWebView*> (nativeHandle);
+
+    if (self == nullptr || ! self->callbacks.fetchResource)
+        return nullptr;
+
+    auto resource = self->callbacks.fetchResource (toString (*env, path));
+
+    if (! resource)
+        return nullptr;
+
+    auto byteArray = env->NewByteArray (static_cast<jsize> (resource->data.size()));
+    env->SetByteArrayRegion (byteArray, 0, static_cast<jsize> (resource->data.size()),
+                             reinterpret_cast<const jbyte*> (resource->data.data()));
+
+    LocalRef<jclass> streamClass (findClass (*env, "java/io/ByteArrayInputStream"));
+    auto streamCtor = env->GetMethodID (streamClass, "<init>", "([B)V");
+    LocalRef<jobject> stream (env->NewObject (streamClass, streamCtor, byteArray));
+    env->DeleteLocalRef (byteArray);
+
+    LocalRef<jclass> responseClass (findClass (*env, "android/webkit/WebResourceResponse"));
+    auto responseCtor = env->GetMethodID (responseClass, "<init>", "(Ljava/lang/String;Ljava/lang/String;Ljava/io/InputStream;)V");
+    LocalRef<jstring> mimeType (toJString (*env, resource->mimeType));
+    LocalRef<jstring> encoding (toJString (*env, "UTF-8"));
+
+    return env->NewObject (responseClass, responseCtor, mimeType.get(), encoding.get(), stream.get());
+}
+
+inline NativeWebView::NativeWebView (Callbacks cb) : callbacks (std::move (cb))
+{
+    auto& env = *getEnv();
+    auto& bindings = getBindings();
+
+    auto context = getApplicationContext();
+    CHOC_ASSERT (context != nullptr); // did you forget to call choc::android::initialise()?
+
+    auto localView = env.NewObject (bindings.viewClass, bindings.constructor, context, reinterpret_cast<jlong> (this));
+
+    if (checkAndClearException (env) || localView == nullptr)
+        return;
+
+    javaView = GlobalRef<jobject> (localView);
+    env.DeleteLocalRef (localView);
+}
+
+inline NativeWebView::~NativeWebView()
+{
+    if (javaView)
+    {
+        auto& env = *getEnv();
+        env.CallVoidMethod (javaView, getBindings().destroyMethod);
+        checkAndClearException (env);
+    }
+}
+
+inline void NativeWebView::navigate (const std::string& url)
+{
+    auto& env = *getEnv();
+    LocalRef<jstring> jurl (toJString (env, url));
+    env.CallVoidMethod (javaView, getBindings().navigateMethod, jurl.get());
+    checkAndClearException (env);
+}
+
+inline void NativeWebView::loadHTML (const std::string& html, const std::string& baseURL)
+{
+    auto& env = *getEnv();
+    LocalRef<jstring> jhtml (toJString (env, html));
+    LocalRef<jstring> jbase (toJString (env, baseURL));
+    env.CallVoidMethod (javaView, getBindings().loadHTMLMethod, jhtml.get(), jbase.get());
+    checkAndClearException (env);
+}
+
+inline void NativeWebView::addInitScript (const std::string& script)
+{
+    auto& env = *getEnv();
+    LocalRef<jstring> jscript (toJString (env, script));
+    env.CallVoidMethod (javaView, getBindings().addInitScriptMethod, jscript.get());
+    checkAndClearException (env);
+}
+
+inline void NativeWebView::evaluateJavascript (const std::string& script, uint64_t callbackToken)
+{
+    auto& env = *getEnv();
+    LocalRef<jstring> jscript (toJString (env, script));
+    env.CallVoidMethod (javaView, getBindings().evaluateJavascriptMethod, jscript.get(), static_cast<jlong> (callbackToken));
+    checkAndClearException (env);
+}
+
+inline void NativeWebView::setUserAgent (const std::string& userAgent)
+{
+    auto& env = *getEnv();
+    LocalRef<jstring> jua (toJString (env, userAgent));
+    env.CallVoidMethod (javaView, getBindings().setUserAgentMethod, jua.get());
+    checkAndClearException (env);
+}
+
+inline void NativeWebView::setTransparentBackground (bool transparent)
+{
+    auto& env = *getEnv();
+    env.CallVoidMethod (javaView, getBindings().setTransparentBackgroundMethod, static_cast<jboolean> (transparent));
+    checkAndClearException (env);
+}
+
+} // namespace choc::android
+
+#endif // CHOC_ANDROID
+#endif // CHOC_ANDROID_WEBVIEW_JNI_HEADER_INCLUDED
