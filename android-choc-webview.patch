diff --git a/choc/gui/choc_MessageLoop.h b/choc/gui/choc_MessageLoop.h
index 89d6059..da0f7b6 100644
--- a/choc/gui/choc_MessageLoop.h
+++ b/choc/gui/choc_MessageLoop.h
@@ -228,6 +228,145 @@ struct Timer::Pimpl
     guint handle;
 };
 
+//==============================================================================
+#elif CHOC_ANDROID
+
+#include <thread>
+#include <mutex>
+#include <condition_variable>
+#include <unordered_set>
+
+#include "../platform/choc_AndroidMainThread.h"
+
+namespace choc::messageloop
+{
+
+inline std::thread::id& getMainThreadIDRef()
+{
+    static std::thread::id i;
+    return i;
+}
+
+inline void initialise()
+{
+    getMainThreadIDRef() = std::this_thread::get_id();
+}
+
+inline bool callerIsOnMessageThread()
+{
+    return getMainThreadIDRef() == std::this_thread::get_id();
+}
+
+inline void postMessage (std::function<void()>&& fn)
+{
+    choc::android::postToMainThread (std::move (fn));
+}
+
+namespace detail
+{
+    // NB: on Android, the main thread's message loop is owned and pumped by
+    // the OS as part of ActivityThread, so a real app should never need to
+    // call choc::messageloop::run()/stop() - it should just call initialise()
+    // once from its main thread, and let Android's own Looper drive things
+    // from then on (postMessage() above reaches it via a Handler). This
+    // fallback loop only exists so that code written for choc's other
+    // platforms (which do expect to be able to run()/stop() a loop) still
+    // links when built for Android.
+    struct FallbackRunLoop
+    {
+        std::mutex mutex;
+        std::condition_variable condition;
+        bool shouldStop = false;
+    };
+
+    inline FallbackRunLoop& getFallbackRunLoop()
+    {
+        static FallbackRunLoop loop;
+        return loop;
+    }
+}
+
+inline void run()
+{
+    initialise();
+
+    auto& loop = detail::getFallbackRunLoop();
+    std::unique_lock<std::mutex> l (loop.mutex);
+    loop.shouldStop = false;
+    loop.condition.wait (l, [&loop] { return loop.shouldStop; });
+}
+
+inline void stop()
+{
+    auto& loop = detail::getFallbackRunLoop();
+    std::lock_guard<std::mutex> l (loop.mutex);
+    loop.shouldStop = true;
+    loop.condition.notify_all();
+}
+
+struct Timer::Pimpl
+{
+    Pimpl (Callback&& c, uint32_t i) : callback (std::move (c)), interval (i)
+    {
+        getList().add (this);
+        scheduleNext();
+    }
+
+    ~Pimpl()
+    {
+        getList().remove (this);
+    }
+
+    void scheduleNext()
+    {
+        choc::android::postToMainThreadDelayed ([this] { staticCallback (this); }, interval);
+    }
+
+    static void staticCallback (Pimpl* context)
+    {
+        if (getList().invokeIfStillAlive (context))
+            context->scheduleNext();
+    }
+
+    Callback callback;
+    uint32_t interval;
+
+    struct TimerList
+    {
+        std::recursive_mutex lock;
+        std::unordered_set<Pimpl*> timers;
+
+        bool invokeIfStillAlive (Pimpl* p)
+        {
+            std::scoped_lock l (lock);
+
+            // must check before AND after the call because the Pimpl
+            // may be deleted during the callback
+            return timers.find (p) != timers.end()
+                    && p->callback()
+                    && timers.find (p) != timers.end();
+        }
+
+        void add (Pimpl* p)
+        {
+            std::scoped_lock l (lock);
+            timers.insert (p);
+        }
+
+        void remove (Pimpl* p)
+        {
+            std::scoped_lock l (lock);
+            timers.erase (p);
+        }
+    };
+
+    static TimerList& getList()
+    {
+        static TimerList list;
+        return list;
+    }
+};
+
