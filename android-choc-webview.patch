+        if (! completionHandler)
+        {
+            nativeView->evaluateJavascript (script, 0);
+            return true;
+        }
+
+        auto token = nextEvaluationToken.fetch_add (1) + 1;
+
+        {
+            std::scoped_lock l (pendingEvaluationsLock);
+            pendingEvaluations[token] = std::move (completionHandler);
+        }
+
+        nativeView->evaluateJavascript (script, token);
+        return true;
+    }
