+        return true;
+    }
+
+    bool setHTML (const std::string& html)
+    {
+        if (nativeView == nullptr)
+            return false;
+
+        nativeView->loadHTML (html, {});
+        return true;
+    }
+
+    bool addInitScript (const std::string& script)
+    {
+        if (nativeView == nullptr)
+            return false;
