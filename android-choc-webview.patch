+//   WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+//   CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+
+#ifndef CHOC_ANDROID_MAIN_THREAD_HEADER_INCLUDED
+#define CHOC_ANDROID_MAIN_THREAD_HEADER_INCLUDED
+
+#include "choc_Platform.h"
+
+#if CHOC_ANDROID
+
+#include <functional>
+#include <memory>
+#include <cstdint>
+
+#include "choc_AndroidJNIHelpers.h"
+
+//==============================================================================
+/**
+    Lets native code post a function to be run asynchronously on Android's
+    main (UI) thread, via a tiny companion Java class (com.tracktion.choc.ChocMainThread)
+    that wraps android.os.Handler.
+
+    choc::messageloop::postMessage() and choc::messageloop::Timer both use this
+    (see choc_MessageLoop.h) - this is the only other place besides
+    choc_AndroidWebViewJNI.h that touches Android's JNI API directly.
+*/
+namespace choc::android
+{
+
+/// Posts a function to be invoked asynchronously on Android's main thread.
+inline void postToMainThread (std::function<void()>&& fn);
+
+/// Like postToMainThread(), but only invokes the function after the given delay.
+inline void postToMainThreadDelayed (std::function<void()>&& fn, uint32_t delayMillis);
+
+
+//==============================================================================
+//        _        _           _  _
+//     __| |  ___ | |_   __ _ (_)| | ___
+//    / _` | / _ \| __| / _` || || |/ __|
+//   | (_| ||  __/| |_ | (_| || || |\__ \ _  _  _
+//    \__,_| \___| \__| \__,_||_||_||___/(_)(_)(_)
+//
+//   Code beyond this point is implementation detail...
+//
+//==============================================================================
+
+namespace detail
+{
+    struct MainThreadBindings
+    {
+        jclass dispatcherClass = {};
+        jmethodID postMethod = {};
+        jmethodID postDelayedMethod = {};
+    };
+
+    inline void JNICALL nativeDispatch (JNIEnv*, jclass, jlong token)
+    {
+        std::unique_ptr<std::function<void()>> fn (reinterpret_cast<std::function<void()>*> (token));
+        (*fn)();
+    }
+
+    inline MainThreadBindings& getMainThreadBindings()
+    {
+        static MainThreadBindings bindings = []
+        {
+            auto& env = *getEnv();
+            MainThreadBindings b;
+
+            auto localClass = findClass (env, "com/tracktion/choc/ChocMainThread");
+            b.dispatcherClass = static_cast<jclass> (env.NewGlobalRef (localClass));
+            env.DeleteLocalRef (localClass);
+
+            b.postMethod        = env.GetStaticMethodID (b.dispatcherClass, "post", "(J)V");
+            b.postDelayedMethod = env.GetStaticMethodID (b.dispatcherClass, "postDelayed", "(JJ)V");
+
+            JNINativeMethod methods[] =
+            {
+                { const_cast<char*> ("nativeDispatch"), const_cast<char*> ("(J)V"), reinterpret_cast<void*> (&nativeDispatch) }
+            };
+
+            env.RegisterNatives (b.dispatcherClass, methods, 1);
+            checkAndClearException (env);
+            return b;
+        }();
+
+        return bindings;
+    }
+}
+
+inline void postToMainThread (std::function<void()>&& fn)
+{
+    auto& env = *getEnv();
+    auto& bindings = detail::getMainThreadBindings();
+    auto token = reinterpret_cast<jlong> (new std::function<void()> (std::move (fn)));
+    env.CallStaticVoidMethod (bindings.dispatcherClass, bindings.postMethod, token);
+    checkAndClearException (env);
+}
+
+inline void postToMainThreadDelayed (std::function<void()>&& fn, uint32_t delayMillis)
+{
+    auto& env = *getEnv();
+    auto& bindings = detail::getMainThreadBindings();
+    auto token = reinterpret_cast<jlong> (new std::function<void()> (std::move (fn)));
+    env.CallStaticVoidMethod (bindings.dispatcherClass, bindings.postDelayedMethod, token, static_cast<jlong> (delayMillis));
+    checkAndClearException (env);
+}
+
+} // namespace choc::android
+
+#endif // CHOC_ANDROID
+#endif // CHOC_ANDROID_MAIN_THREAD_HEADER_INCLUDED
