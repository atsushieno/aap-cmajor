+//   WARRANTIES WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF MERCHANTABILITY
+//   AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR ANY SPECIAL, DIRECT, INDIRECT, OR
+//   CONSEQUENTIAL DAMAGES OR ANY DAMAGES WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS,
+//   WHETHER IN AN ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF OR IN
+//   CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
+
+#ifndef CHOC_ANDROID_JNI_HELPERS_HEADER_INCLUDED
+#define CHOC_ANDROID_JNI_HELPERS_HEADER_INCLUDED
+
+#include "choc_Platform.h"
+
+#if CHOC_ANDROID
+
+#include <jni.h>
+#include <string>
+#include <atomic>
+#include <mutex>
+
+#include "choc_Assert.h"
+
+//==============================================================================
+/**
+    This namespace contains the only place in choc that is allowed to touch the
+    Android JNI API directly. Every other choc header that needs to reach the
+    JVM (e.g. choc::ui::WebView's Android backend) goes through the plain C++
+    entry points declared here, so that all the JNI boilerplate and lifetime
+    bookkeeping lives in one place.
+
+    Before any choc code that needs the JVM can be used (e.g. constructing a
+    choc::ui::WebView), the hosting application must call
+    choc::android::initialise() exactly once, normally from JNI_OnLoad() or
+    from the application's earliest Java-called native entry point, passing
+    the JavaVM and an application Context (an Activity or the Application
+    object both work).
+*/
+namespace choc::android
+{
+
+//==============================================================================
+/// Stores the JavaVM and application Context that the rest of choc's Android
+/// support relies on. Must be called once, before any other choc::android or
+/// choc::ui::WebView functionality is used.
+inline void initialise (JavaVM* vm, jobject applicationContext);
+
+/// Returns the JavaVM passed to initialise(), or nullptr if it hasn't been called yet.
+inline JavaVM* getJavaVM();
+
+/// Returns the application Context passed to initialise() (as a global reference),
+/// or nullptr if it hasn't been called yet.
+inline jobject getApplicationContext();
+
+/// Returns the JNIEnv for the calling thread, attaching the thread to the JVM
+/// first if necessary. Threads that get attached by this call are automatically
+/// detached again when they exit.
+inline JNIEnv* getEnv();
+
+/// Looks up a class by its JNI name (e.g. "com/tracktion/choc/gui/ChocWebView").
+/// This first tries the normal JNIEnv::FindClass(), then falls back to asking
+/// the application Context's own ClassLoader, since FindClass() can't see
+/// application classes when called from a thread that wasn't created by the JVM.
+inline jclass findClass (JNIEnv&, const char* jniClassName);
+
+/// Converts a jstring to a std::string. Handles a null jstring by returning {}.
+inline std::string toString (JNIEnv&, jstring);
+
+/// Creates a local-ref jstring from a std::string.
+inline jstring toJString (JNIEnv&, const std::string&);
+
+/// Returns true and clears the exception if the calling thread has a pending
+/// Java exception (and prints a description of it via ExceptionDescribe() to
+/// help with debugging). Should be called after any JNI call that might throw.
+inline bool checkAndClearException (JNIEnv&);
+
+//==============================================================================
+/// A simple RAII wrapper for a JNI local reference, so it gets deleted
+/// automatically rather than having to rely on the JNI local-ref frame.
+template <typename JNIType>
+struct LocalRef
+{
+    LocalRef() = default;
+    explicit LocalRef (JNIType r) : ref (r) {}
+    LocalRef (const LocalRef&) = delete;
+    LocalRef (LocalRef&& other) noexcept : ref (other.ref)  { other.ref = {}; }
+
+    LocalRef& operator= (LocalRef&& other) noexcept
+    {
+        reset();
+        ref = other.ref;
+        other.ref = {};
+        return *this;
+    }
+
+    ~LocalRef()  { reset(); }
+
+    void reset()
+    {
+        if (ref != nullptr)
+        {
+            getEnv()->DeleteLocalRef (ref);
+            ref = {};
+        }
+    }
+
+    JNIType get() const noexcept        { return ref; }
+    operator JNIType() const noexcept   { return ref; }
+    explicit operator bool() const      { return ref != nullptr; }
+
+    JNIType ref = {};
+};
+
+/// A simple RAII wrapper for a JNI global reference.
+template <typename JNIType>
+struct GlobalRef
+{
+    GlobalRef() = default;
+
+    explicit GlobalRef (JNIType local)
+    {
+        if (local != nullptr)
+            ref = static_cast<JNIType> (getEnv()->NewGlobalRef (local));
+    }
+
+    GlobalRef (const GlobalRef&) = delete;
+    GlobalRef (GlobalRef&& other) noexcept : ref (other.ref)  { other.ref = {}; }
+
+    GlobalRef& operator= (GlobalRef&& other) noexcept
+    {
+        reset();
+        ref = other.ref;
+        other.ref = {};
+        return *this;
+    }
+
+    ~GlobalRef()  { reset(); }
+
+    void reset()
+    {
+        if (ref != nullptr)
+        {
+            getEnv()->DeleteGlobalRef (ref);
+            ref = {};
+        }
+    }
+
+    JNIType get() const noexcept        { return ref; }
+    operator JNIType() const noexcept   { return ref; }
+    explicit operator bool() const      { return ref != nullptr; }
+
+    JNIType ref = {};
+};
+
+
+//==============================================================================
+//        _        _           _  _
+//     __| |  ___ | |_   __ _ (_)| | ___
+//    / _` | / _ \| __| / _` || || |/ __|
+//   | (_| ||  __/| |_ | (_| || || |\__ \ _  _  _
+//    \__,_| \___| \__| \__,_||_||_||___/(_)(_)(_)
+//
+//   Code beyond this point is implementation detail...
+//
+//==============================================================================
+
+inline JavaVM*& getJavaVMRef()
+{
+    static JavaVM* vm = nullptr;
+    return vm;
+}
+
+inline GlobalRef<jobject>& getApplicationContextRef()
+{
+    static GlobalRef<jobject> context;
+    return context;
+}
+
+inline void initialise (JavaVM* vm, jobject applicationContext)
+{
+    getJavaVMRef() = vm;
+
+    JNIEnv* env = nullptr;
+    vm->GetEnv (reinterpret_cast<void**> (&env), JNI_VERSION_1_6);
+    CHOC_ASSERT (env != nullptr); // initialise() must be called on a thread that's already attached to the JVM
+
+    getApplicationContextRef() = GlobalRef<jobject> (applicationContext);
+}
+
+inline JavaVM* getJavaVM()
+{
+    return getJavaVMRef();
+}
+
+inline jobject getApplicationContext()
+{
+    return getApplicationContextRef().get();
+}
+
+inline JNIEnv* getEnv()
+{
+    struct ThreadAttachment
+    {
+        ~ThreadAttachment()
+        {
+            if (attachedByUs)
+                if (auto vm = getJavaVMRef())
+                    vm->DetachCurrentThread();
+        }
+
+        bool attachedByUs = false;
+    };
+
+    static thread_local ThreadAttachment attachment;
+
+    auto vm = getJavaVMRef();
+    CHOC_ASSERT (vm != nullptr); // you must call choc::android::initialise() before using any JNI-dependent choc functionality
+
+    JNIEnv* env = nullptr;
+
+    if (vm->GetEnv (reinterpret_cast<void**> (&env), JNI_VERSION_1_6) == JNI_EDETACHED)
+    {
+        JavaVMAttachArgs args { JNI_VERSION_1_6, "choc", nullptr };
+
+        if (vm->AttachCurrentThread (&env, &args) == JNI_OK)
+            attachment.attachedByUs = true;
+    }
+
+    return env;
+}
+
+inline bool checkAndClearException (JNIEnv& env)
+{
+    if (env.ExceptionCheck())
+    {
+        env.ExceptionDescribe();
+        env.ExceptionClear();
+        return true;
+    }
+
+    return false;
+}
+
+inline jclass findClass (JNIEnv& env, const char* jniClassName)
+{
+    if (auto direct = env.FindClass (jniClassName))
+        return direct;
+
+    env.ExceptionClear();
+
+    // Fall back to going via the application Context's ClassLoader, which is
+    // needed when this is called from a thread that wasn't created by the JVM
+    // (a common case for choc's own worker threads).
+    auto context = getApplicationContext();
+    CHOC_ASSERT (context != nullptr); // did you forget to call choc::android::initialise()?
+
+    LocalRef<jclass> contextClass (env.GetObjectClass (context));
+    auto getClassLoaderMethod = env.GetMethodID (contextClass, "getClassLoader", "()Ljava/lang/ClassLoader;");
+    LocalRef<jobject> classLoader (env.CallObjectMethod (context, getClassLoaderMethod));
+
+    LocalRef<jclass> classLoaderClass (env.FindClass ("java/lang/ClassLoader"));
+    auto loadClassMethod = env.GetMethodID (classLoaderClass, "loadClass", "(Ljava/lang/String;)Ljava/lang/Class;");
+
+    std::string dottedName = jniClassName;
+
+    for (auto& c : dottedName)
+        if (c == '/')
+            c = '.';
+
+    LocalRef<jstring> nameString (toJString (env, dottedName));
+    auto result = static_cast<jclass> (env.CallObjectMethod (classLoader, loadClassMethod, nameString.get()));
+    checkAndClearException (env);
+    return result;
+}
+
+inline std::string toString (JNIEnv& env, jstring s)
+{
+    if (s == nullptr)
+        return {};
+
+    auto length = static_cast<size_t> (env.GetStringUTFLength (s));
+    auto chars = env.GetStringUTFChars (s, nullptr);
+    std::string result (chars, length);
+    env.ReleaseStringUTFChars (s, chars);
+    return result;
+}
+
+inline jstring toJString (JNIEnv& env, const std::string& s)
+{
+    return env.NewStringUTF (s.c_str());
+}
+
+} // namespace choc::android
+
+#endif // CHOC_ANDROID
+#endif // CHOC_ANDROID_JNI_HELPERS_HEADER_INCLUDED
