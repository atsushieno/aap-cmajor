+    void handleEvaluationResult (uint64_t token, const std::string& error, const std::string& json)
+    {
+        CompletionHandler handler;
+
+        {
+            std::scoped_lock l (pendingEvaluationsLock);
+
+            if (auto found = pendingEvaluations.find (token); found != pendingEvaluations.end())
+            {
+                handler = std::move (found->second);
+                pendingEvaluations.erase (found);
+            }
+        }
+
+        if (handler == nullptr)
+            return;
+
+        choc::value::Value value;
+
+        if (error.empty() && ! json.empty())
+        {
+            try
+            {
+                value = choc::json::parseValue (json);
+            }
+            catch (const std::exception& e)
+            {
+                handler (e.what(), {});
+                return;
+            }
+        }
+
+        handler (error, value);
+    }
+
+    WebView& owner;
+    const Options options;
+    Options::FetchResource fetchResource;
+    std::string defaultURI;
+    std::unique_ptr<choc::android::NativeWebView> nativeView;
+    std::shared_ptr<DeletionChecker> deletionChecker { std::make_shared<DeletionChecker>() };
+
+    std::mutex pendingEvaluationsLock;
+    std::unordered_map<uint64_t, CompletionHandler> pendingEvaluations;
+    std::atomic<uint64_t> nextEvaluationToken { 0 };
+};
